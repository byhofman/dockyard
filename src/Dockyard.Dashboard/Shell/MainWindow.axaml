<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Dockyard.Dashboard.Shell"
        xmlns:cont="using:Dockyard.Dashboard.Features.Containers"
        xmlns:res="using:Dockyard.Dashboard.Features.Resources"
        xmlns:clu="using:Dockyard.Dashboard.Features.Clusters"
        xmlns:bld="using:Dockyard.Dashboard.Features.Builds"
        xmlns:ctl="using:Dockyard.Shared"
        xmlns:dctl="using:Dockyard.Dashboard.Controls"
        x:Class="Dockyard.Dashboard.Shell.MainWindow"
        x:DataType="shell:ShellViewModel"
        Title="Dockyard Dashboard"
        Icon="avares://Dockyard.Dashboard/Assets/dockyard.ico"
        Width="1240" Height="760" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <Window.DataTemplates>
    <DataTemplate DataType="cont:ContainersViewModel">
      <cont:ContainersView />
    </DataTemplate>
    <DataTemplate DataType="res:ImagesViewModel">
      <res:ImagesView />
    </DataTemplate>
    <DataTemplate DataType="res:VolumesViewModel">
      <res:VolumesView />
    </DataTemplate>
    <DataTemplate DataType="shell:LogTab">
      <Panel>
        <Panel IsVisible="{Binding IsActivity}">
          <TextBlock Classes="muted small mono" IsVisible="{Binding !Activity.HasLines, FallbackValue=False}" TextWrapping="Wrap" Margin="14,8"
                     Text="Nothing yet. What the dashboard does, such as starting containers or making clusters, shows up here." />
          <ListBox Classes="log activitylist" ItemsSource="{Binding Activity.Lines, FallbackValue={x:Null}}" Background="{DynamicResource Bg}" Padding="0,2,0,8">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="shell:ActivityEntry">
                <Grid ColumnDefinitions="70,14,*" Margin="6,0,6,0" Classes.activitystep="{Binding IsStep}">
                  <TextBlock Classes="muted mono small" Text="{Binding TimeText}" VerticalAlignment="Top" Margin="0,1,0,0" />
                  <Ellipse Grid.Column="1" Classes="activitydot" Classes.step="{Binding IsStep}" Classes.info="{Binding IsInfo}" Classes.error="{Binding IsError}"
                           IsVisible="{Binding !IsDetail}" VerticalAlignment="Top" Margin="0,5,0,0" />
                  <SelectableTextBlock Grid.Column="2" Classes="activity console" Classes.step="{Binding IsStep}" Classes.detail="{Binding IsDetail}"
                                       Classes.command="{Binding IsCommand}" Classes.error="{Binding IsError}"
                                       Text="{Binding Text}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
        <dctl:FollowingLogList Classes="log" Logs="{Binding Logs}" IsVisible="{Binding IsLogs}" Background="{DynamicResource Bg}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <dctl:FollowingLogList.ItemTemplate>
            <DataTemplate DataType="cont:LogRow">
              <dctl:AnsiTextBlock Classes="mono" Classes.err="{Binding IsError}" Line="{Binding Line}" />
            </DataTemplate>
          </dctl:FollowingLogList.ItemTemplate>
        </dctl:FollowingLogList>
      </Panel>
    </DataTemplate>
    <DataTemplate DataType="res:NetworksViewModel">
      <res:NetworksView />
    </DataTemplate>
    <DataTemplate DataType="bld:BuildsViewModel">
      <bld:BuildsView />
    </DataTemplate>
    <DataTemplate DataType="res:DiskViewModel">
      <res:DiskView />
    </DataTemplate>
    <DataTemplate DataType="clu:ClustersViewModel">
      <clu:ClustersView />
    </DataTemplate>
  </Window.DataTemplates>

  <Window.Styles>
    <Style Selector="Border.searchmenu">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BoxShadow" Value="0 10 28 0 #40000000" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ListBox.search">
      <Setter Property="Padding" Value="0,6" />
    </Style>
    <Style Selector="ListBox.search ListBoxItem" x:DataType="shell:SearchHit">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="6,1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
    </Style>
    <Style Selector="ListBox.search ListBoxItem:disabled">
      <Setter Property="Padding" Value="8,10,8,2" />
    </Style>
    <Style Selector="ListBox.search ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
    </Style>
    <Style Selector="ListBox.search ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Selected}" />
    </Style>
    <Style Selector="ListBox.search ListBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.searchicon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.searchicon PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="ListBox.search ListBoxItem:selected Border.searchicon">
      <Setter Property="Background" Value="{DynamicResource AccentBg}" />
    </Style>
    <Style Selector="ListBox.search ListBoxItem:selected Border.searchicon PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector="Border.toast">
      <Setter Property="Background" Value="{DynamicResource OkBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Ok}" />
    </Style>
    <Style Selector="Border.toast.error">
      <Setter Property="Background" Value="{DynamicResource BadBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Bad}" />
    </Style>
  </Window.Styles>

  <Panel>
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Image Source="avares://Dockyard.Dashboard/Assets/dockyard.png" Width="26" Height="26" />
            <TextBlock Classes="h1" Text="Dockyard" VerticalAlignment="Center" />
          </StackPanel>

          <TextBox x:Name="SearchBox" Grid.Column="1" Margin="40,0,16,0" MaxWidth="380" HorizontalAlignment="Stretch"
                   PlaceholderText="{Binding SearchHint}" Text="{Binding Search}" VerticalAlignment="Center" >
            <TextBox.InnerLeftContent>
              <PathIcon Data="{StaticResource IconSearch}" Margin="10,0,0,0" Foreground="{DynamicResource Muted}" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <Popup Grid.Column="1" PlacementTarget="{Binding #SearchBox}" Placement="BottomEdgeAlignedLeft" VerticalOffset="6"
                 IsOpen="{Binding IsSearchOpen, Mode=TwoWay}" IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding #SearchBox}">
            <Border Classes="searchmenu" Width="{Binding #SearchBox.Bounds.Width}" MinWidth="380">
              <DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,8" IsVisible="{Binding !HasNoHits}">
                  <TextBlock Classes="muted small" Text="↑ ↓  to move     Enter  to open     Esc  to close" />
                </Border>
                <StackPanel>
                  <StackPanel Margin="16,18" Spacing="4" IsVisible="{Binding HasNoHits}">
                    <TextBlock FontWeight="SemiBold" Text="Nothing matches" />
                    <TextBlock Classes="muted small" Text="Containers, Compose projects, images, volumes, networks and clusters are searched by name." TextWrapping="Wrap" />
                  </StackPanel>
                  <ListBox x:Name="SearchResults" Classes="search" ItemsSource="{Binding Hits}" SelectedIndex="{Binding HitIndex, Mode=TwoWay}" MaxHeight="440"
                           Tapped="OpenSearchResult" Focusable="False">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="shell:SearchHit">
                        <Panel>
                          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsHeader}" Margin="4,0">
                            <TextBlock Classes="section" Text="{Binding HeaderText}" />
                            <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding TotalText}" VerticalAlignment="Center" />
                          </Grid>
                          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsSelectable}">
                            <Border Classes="searchicon">
                              <PathIcon Data="{Binding Icon}" Width="14" Height="14" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="muted small" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                          </Grid>
                        </Panel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </DockPanel>
            </Border>
          </Popup>

          <Border Grid.Column="2" Classes="pill warn" Margin="0,0,12,0" IsVisible="{Binding Session.IsReconnecting}">
            <TextBlock Text="Reconnecting…" />
          </Border>

          <Border Grid.Column="3" IsVisible="{Binding HasEngineSwitch}" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}"
                  BorderThickness="1" CornerRadius="7" Padding="3" VerticalAlignment="Center" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="segment" Classes.selected="{Binding IsLinuxActive}" Content="Linux" Command="{Binding SwitchLinuxCommand}"
                      ToolTip.Tip="Switch to Linux containers" />
              <Button Classes="segment" Classes.selected="{Binding IsWindowsActive}" Content="Windows" Command="{Binding SwitchWindowsCommand}"
                      ToolTip.Tip="Switch to Windows containers" />
            </StackPanel>
          </Border>

          <Button Grid.Column="4" Classes="iconbtn" Command="{Binding SettingsCommand}" ToolTip.Tip="Engines, updates and settings">
            <PathIcon Data="{StaticResource IconSettings}" Width="18" Height="18" />
          </Button>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,4">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <Button Classes="iconbtn" Command="{Binding Activity.ToggleCommand}" Margin="-6,0,6,0" ToolTip.Tip="The activity log" AutomationProperties.Name="Activity log">
            <PathIcon Data="{StaticResource IconLogs}" Width="14" Height="14" />
          </Button>
          <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding Activity.IsWorking}" Width="60" MinWidth="60" Margin="0,0,10,0" VerticalAlignment="Center" />
          <Button x:Name="ActivityButton" Grid.Column="2" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left"
                  Command="{Binding Activity.ToggleCommand}" ToolTip.Tip="Show or hide what the dashboard did" AutomationProperties.Name="Activity">
            <TextBlock Classes="muted small" Classes.activityerror="{Binding Activity.CurrentIsError}" Text="{Binding Activity.Current}" TextTrimming="CharacterEllipsis" />
          </Button>

          <TextBlock Grid.Column="3" Classes="muted small" Text="{x:Static shell:ShellViewModel.Version}" VerticalAlignment="Center" Margin="12,0,0,0"
                     ToolTip.Tip="Dockyard's version" />
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom" Height="{Binding Logs.Height}" IsVisible="{Binding Activity.IsOpen}" Background="{DynamicResource Bg}"
              BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
        <DockPanel>
          <Thumb DockPanel.Dock="Top" Classes="resizer" Height="5" Cursor="SizeNorthSouth" DragDelta="ResizeLogs" ToolTip.Tip="Drag to resize" />
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="8,0,8,2">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Logs.Tabs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="shell:LogTab">
                    <Border Classes="logtab" Classes.selected="{Binding IsSelected}">
                      <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsShown}" IsVisible="{Binding $parent[Window].((shell:ShellViewModel)DataContext).Logs.SideBySide}" MinWidth="0" Padding="0" Margin="6,0,0,0"
                                  ToolTip.Tip="Show this one side by side" AutomationProperties.Name="{Binding Title}" />
                        <Button Classes="logtab" Command="{Binding $parent[Window].((shell:ShellViewModel)DataContext).Logs.SelectCommand}" CommandParameter="{Binding}">
                          <StackPanel Classes="label" Spacing="6">
                            <PathIcon Data="{StaticResource IconLogs}" Width="12" Height="12" />
                            <TextBlock Text="{Binding Title}" />
                          </StackPanel>
                        </Button>
                        <Button Classes="iconbtn" Padding="4" IsVisible="{Binding CanClose}" ToolTip.Tip="Close" AutomationProperties.Name="Close tab"
                                Command="{Binding $parent[Window].((shell:ShellViewModel)DataContext).Logs.CloseTabCommand}" CommandParameter="{Binding}">
                          <PathIcon Data="{StaticResource IconClose}" Width="9" Height="9" />
                        </Button>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Button Grid.Column="1" Classes="iconbtn" Classes.selected="{Binding Logs.SideBySide}" Command="{Binding Logs.ToggleSideBySideCommand}"
                    IsVisible="{Binding Logs.HasLogTabs}" ToolTip.Tip="Side by side, or one at a time" AutomationProperties.Name="Side by side" Margin="0,0,6,0">
              <PathIcon Data="{StaticResource IconSideBySide}" Width="14" Height="14" />
            </Button>
            <Button Grid.Column="2" Classes="link" Content="Copy" Click="CopyActivity" ToolTip.Tip="Copy what this tab shows" />
            <Button Grid.Column="3" Classes="link" Content="Clear" Command="{Binding Activity.ClearCommand}" IsVisible="{Binding Logs.SelectedIsActivity}"
                    IsEnabled="{Binding Activity.HasLines}" Margin="10,0,6,0" />
            <Button Grid.Column="4" Classes="iconbtn" Command="{Binding Activity.ToggleCommand}" ToolTip.Tip="Close" Margin="6,0,0,0">
              <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
            </Button>
          </Grid>
          <Panel>
            <ContentControl Content="{Binding Logs.Selected}" IsVisible="{Binding Logs.ShowsOne}" />
            <ItemsControl ItemsSource="{Binding Logs.ShownTabs}" IsVisible="{Binding Logs.SideBySide}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="shell:LogTab">
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Top" Classes="muted small" Text="{Binding Title}" Margin="14,4,8,2" TextTrimming="CharacterEllipsis" />
                      <ContentControl Content="{Binding}" />
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
        </DockPanel>
      </Border>

      <Border DockPanel.Dock="Top" Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,6"
              IsVisible="{Binding Tools.HasHint}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Tools.Hint}" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="link" Content="Open the Toolbox" Command="{Binding SettingsCommand}" Margin="12,0,0,0" />
        </Grid>
      </Border>

      <Grid ColumnDefinitions="170,*">
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
          <ListBox Classes="sidebar" Margin="0,10" ItemsSource="{Binding Sections}" SelectedItem="{Binding CurrentSection}">
            <!-- Otherwise an item is named after the record's ToString, so screen readers and UI Automation never find "Clusters". -->
            <ListBox.Styles>
              <Style Selector="ListBoxItem" x:DataType="shell:Section">
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="shell:Section">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Data="{Binding Icon}" Width="16" Height="16" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
        <ContentControl Grid.Column="1" Content="{Binding CurrentSection.Content}" />
      </Grid>
    </DockPanel>

    <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" MaxWidth="420">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="8" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="shell:Toast">
          <Border Classes="toast" Classes.error="{Binding IsError}" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
              <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
              <Button Grid.Column="1" Classes="iconbtn" VerticalAlignment="Top" Margin="8,-4,-6,0" Click="DismissToast">
                <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Panel x:Name="DialogLayer" IsVisible="{Binding HasDialog}">
      <Border Background="{DynamicResource Scrim}" Opacity="0.55" />
      <Border Classes="dialog" DataContext="{Binding Dialog}" x:DataType="shell:Dialog"
              HorizontalAlignment="Center" VerticalAlignment="Center" Width="{Binding Width}" Margin="16"
              Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="20,18">
        <!-- The title and the buttons stay in view; what lies between scrolls when the window is shorter than the dialog. -->
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" Classes="title" Text="{Binding Title}" TextWrapping="Wrap" Margin="0,0,0,12" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="Hide" Command="{Binding HideCommand}" IsVisible="{Binding IsWorking}"
                    ToolTip.Tip="Close this; it goes on, and says how it ended" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsIdle}" IsCancel="True" />
            <Button Classes="primary" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True" IsVisible="{Binding IsPrimary}" />
            <Button Classes="dangerfill" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsVisible="{Binding IsDanger}" />
          </StackPanel>
          <Border DockPanel.Dock="Bottom" Background="{DynamicResource BadBg}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0" IsVisible="{Binding HasError}">
            <ScrollViewer MaxHeight="160">
              <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0" IsVisible="{Binding HasProgress}">
            <ProgressBar IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding Percent}" Maximum="100" />
            <TextBlock Classes="muted small" Text="{Binding Progress}" TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12" Margin="0,0,12,0">
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding HasMessage}" />
          <ItemsControl ItemsSource="{Binding Fields}" IsEnabled="{Binding IsIdle}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="shell:DialogField">
                <StackPanel Spacing="4" IsVisible="{Binding IsShown}">
                  <TextBlock Classes="muted small" Text="{Binding Label}" IsVisible="{Binding HasLabel}" />
                  <TextBox Classes="dialogfield" Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" IsVisible="{Binding IsText}"
                           AutomationProperties.Name="{Binding Label}" />
                  <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" IsVisible="{Binding IsChoice}"
                            AutomationProperties.Name="{Binding Label}" />
                  <CheckBox IsChecked="{Binding IsChecked}" IsVisible="{Binding IsCheck}" AutomationProperties.Name="{Binding Label}">
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                  </CheckBox>
                  <ctl:CodeEditor Height="260" Language="{Binding Language}" Text="{Binding Text}" IsVisible="{Binding IsCode}" AutomationProperties.Name="{Binding Label}" />
                  <TextBlock Foreground="{DynamicResource Bad}" FontSize="12" TextWrapping="Wrap" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" />
                  <TextBlock Foreground="{DynamicResource Warn}" FontSize="12" TextWrapping="Wrap" Text="{Binding Warning}" IsVisible="{Binding HasWarning}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <CheckBox Content="{Binding OptionText}" IsChecked="{Binding Option}" IsVisible="{Binding HasOption}" IsEnabled="{Binding IsIdle}" />
          </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>
  </Panel>
</Window>
