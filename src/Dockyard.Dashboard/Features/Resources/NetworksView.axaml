<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Dockyard.Dashboard.Features.Resources"
             xmlns:store="using:Dockyard.Dashboard.Store"
             x:Class="Dockyard.Dashboard.Features.Resources.NetworksView"
             x:DataType="res:NetworksViewModel">
  <Grid x:Name="Layout" ColumnDefinitions="*,5,380">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="16,14,16,6">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <CheckBox Classes="pick" IsChecked="{Binding AllSelected}" ToolTip.Tip="Select all" AutomationProperties.Name="Select all networks" />
          <StackPanel Grid.Column="1" Classes="pagehead"><TextBlock Classes="title" Text="Networks" /><TextBlock Classes="muted small" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" /></StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Command="{Binding CreateCommand}">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconPlus}" /><TextBlock Text="Create network…" /></StackPanel>
            </Button>
            <Button Command="{Binding PruneCommand}" ToolTip.Tip="Remove the networks no container uses">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconPrune}" /><TextBlock Text="Prune unused…" /></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <Border Classes="selectionbar" IsVisible="{Binding HasMany}">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="count" Text="{Binding SelectionText}" />
            <Button Grid.Column="1" Classes="danger" Command="{Binding RemoveCommand}" ToolTip.Tip="Built-in networks stay">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Remove…" /></StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="link" Content="Clear" Command="{Binding ClearSelectionCommand}" Margin="12,0,0,0" />
          </Grid>
        </Border>
        <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
          <ProgressBar IsIndeterminate="True" />
          <TextBlock Classes="muted small" Text="{Binding Busy}" />
        </StackPanel>
      </StackPanel>
      <ListBox x:Name="List" Classes="rows" ItemsSource="{Binding Rows}" SelectionMode="Multiple" SelectedItems="{Binding SelectedItems}" Padding="0,4">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="res:NetworkRow">
            <Grid ColumnDefinitions="Auto,*,140,110,Auto">
              <CheckBox Classes="pick" IsChecked="{Binding $parent[ListBoxItem].IsSelected}" AutomationProperties.Name="{Binding Name}" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="muted small" Text="{Binding Driver}" />
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="mono muted" Text="{Binding Subnet}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Classes="muted small" Text="{Binding ContainersText}" TextAlignment="Right" VerticalAlignment="Center" />
              <StackPanel Grid.Column="4" Classes="rowactions" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Classes="iconbtn danger" ToolTip.Tip="Remove (Del)" IsEnabled="{Binding !IsBuiltIn}"
                        Command="{Binding $parent[UserControl].((res:NetworksViewModel)DataContext).RemoveRowCommand}" CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource IconDelete}" />
                </Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter x:Name="Splitter" Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

    <Border x:Name="Panel" Grid.Column="2" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel Margin="16,14" Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="title" Text="{Binding Selected.Name, FallbackValue=''}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="iconbtn" Command="{Binding ClearSelectionCommand}" ToolTip.Tip="Close">
              <PathIcon Data="{StaticResource IconClose}" />
            </Button>
          </Grid>
          <TextBlock Classes="muted" Text="{Binding Selected.Driver, FallbackValue=''}" />
          <SelectableTextBlock Classes="mono muted" Text="{Binding Selected.Subnet, FallbackValue=''}" />
          <WrapPanel ItemSpacing="6" LineSpacing="6" Margin="0,4,0,0">
            <Button Classes="danger" Command="{Binding RemoveCommand}" ToolTip.Tip="Built-in networks cannot be removed">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Remove…" /></StackPanel>
            </Button>
          </WrapPanel>

          <TextBlock Classes="section" Text="CONNECTED CONTAINERS" Margin="0,8,0,0" />
          <ItemsControl ItemsSource="{Binding Members}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="res:NetworkMember">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Classes="mono muted" Text="{Binding Address}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="link" Content="Disconnect" VerticalAlignment="Center"
                          Command="{Binding $parent[UserControl].((res:NetworksViewModel)DataContext).DisconnectCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="section" Text="CONNECT A CONTAINER" Margin="0,8,0,0" />
          <Grid ColumnDefinitions="*,Auto">
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Candidates}" SelectedItem="{Binding ConnectCandidate}" PlaceholderText="Container">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="store:ContainerItem">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Content="Connect" Command="{Binding ConnectCommand}" Margin="8,0,0,0" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
