        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Bg" Color="#F4F6F9" />
          <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceRaised" Color="#EEF1F5" />
          <SolidColorBrush x:Key="Hover" Color="#E9EDF2" />
          <SolidColorBrush x:Key="Selected" Color="#E2EEFB" />
          <SolidColorBrush x:Key="SelectedText" Color="#1B5E9E" />
          <SolidColorBrush x:Key="Line" Color="#DCE1E8" />
          <SolidColorBrush x:Key="Text" Color="#1A1F29" />
          <SolidColorBrush x:Key="Muted" Color="#566275" />
          <SolidColorBrush x:Key="Ok" Color="#137A44" />
          <SolidColorBrush x:Key="OkBg" Color="#DDF3E6" />
          <SolidColorBrush x:Key="Warn" Color="#8A5A00" />
          <SolidColorBrush x:Key="WarnBg" Color="#FCEFD6" />
          <SolidColorBrush x:Key="Bad" Color="#B42A26" />
          <SolidColorBrush x:Key="BadBg" Color="#FBE1E0" />
          <SolidColorBrush x:Key="PillBg" Color="#E8EBF0" />
          <SolidColorBrush x:Key="AccentBg" Color="#DCEBFA" />
          <SolidColorBrush x:Key="AccentText" Color="#1B5E9E" />
          <SolidColorBrush x:Key="LinkText" Color="#1663B0" />
          <SolidColorBrush x:Key="Brand" Color="#1B74C9" />
          <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FAFBFC" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
