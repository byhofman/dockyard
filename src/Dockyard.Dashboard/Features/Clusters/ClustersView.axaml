<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:ctl="using:Dockyard.Dashboard.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:clu="using:Dockyard.Dashboard.Features.Clusters"
             xmlns:kind="using:Dockyard.Kind"
             xmlns:store="using:Dockyard.Dashboard.Store"
             x:Class="Dockyard.Dashboard.Features.Clusters.ClustersView"
             x:DataType="clu:ClustersViewModel">
  <UserControl.Resources>
    <clu:ClusterNodes x:Key="ClusterNodes" />
  </UserControl.Resources>
  <Grid x:Name="Layout" ColumnDefinitions="*,5,380">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="16,12,16,4">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <CheckBox Classes="pick" IsChecked="{Binding AllSelected}" ToolTip.Tip="Select all" AutomationProperties.Name="Select all clusters" />
          <TextBlock Grid.Column="1" Classes="section" Text="CLUSTERS" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
            <Button Classes="primary" Command="{Binding CreateCommand}" IsVisible="{Binding HasKind}">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconPlus}" /><TextBlock Text="Create cluster…" /></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <ctl:SectionHint IsVisible="{Binding HasHint}" Text="{Binding Hint}" LinkText="{Binding HintLink}" LinkCommand="{Binding OpenSettingsCommand}" />
        <Border Classes="selectionbar" IsVisible="{Binding HasMany}">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="count" Text="{Binding SelectionText}" />
            <Button Grid.Column="1" Classes="danger" Command="{Binding DeleteCommand}">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Delete…" /></StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="link" Content="Clear" Command="{Binding ClearSelectionCommand}" Margin="12,0,0,0" />
          </Grid>
        </Border>
        <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
          <ProgressBar IsIndeterminate="True" />
          <TextBlock Classes="muted small" Text="{Binding Busy}" />
        </StackPanel>
      </StackPanel>
      <ListBox x:Name="List" Classes="rows" ItemsSource="{Binding Rows}" SelectionMode="Multiple" SelectedItems="{Binding SelectedItems}" Padding="0,4">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="kind:KindCluster">
            <StackPanel>
              <Grid ColumnDefinitions="Auto,Auto,*,120,110,Auto">
                <CheckBox Classes="pick" IsChecked="{Binding $parent[ListBoxItem].IsSelected}" AutomationProperties.Name="{Binding Name}" />
                <ctl:ExpandToggle Grid.Column="1" IsExpanded="{Binding Converter={StaticResource ClusterNodes}, ConverterParameter=unfolded}"
                                  Command="{Binding $parent[UserControl].((clu:ClustersViewModel)DataContext).ToggleNodesCommand}" CommandParameter="{Binding}" />
                <ctl:RowLabel Grid.Column="2" Title="{Binding Name}" Detail="{Binding Context}" IsDetailMono="True" />
                <TextBlock Grid.Column="3" Classes="mono muted" Text="{Binding KubernetesVersion}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                  <TextBlock Classes="small" Text="{Binding StateText}" TextAlignment="Right" />
                  <TextBlock Classes="muted small" Text="{Binding NodesText}" TextAlignment="Right" />
                </StackPanel>
                <StackPanel Grid.Column="5" Classes="rowactions" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                  <ctl:StartStopButton IsRunning="{Binding IsRunning}" ToolTip.Tip="{Binding ToggleText}"
                          Command="{Binding $parent[UserControl].((clu:ClustersViewModel)DataContext).ToggleRowCommand}" CommandParameter="{Binding}" />
                  <Button Classes="iconbtn danger" ToolTip.Tip="Delete (Del)"
                          Command="{Binding $parent[UserControl].((clu:ClustersViewModel)DataContext).DeleteRowCommand}" CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource IconDelete}" />
                  </Button>
                </StackPanel>
              </Grid>
              <ItemsControl ItemsSource="{Binding Converter={StaticResource ClusterNodes}}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="clu:NodeRow">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,4">
                      <Border Width="24" />
                      <ctl:StatusDot Grid.Column="1" IsOn="{Binding IsReady}" ToolTip.Tip="{Binding StateText}" />
                      <ctl:RowLabel Grid.Column="2" Margin="12,0" Title="{Binding Name}" Detail="{Binding Role}" />
                      <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Classes="muted mono" Text="{Binding Container.UsageText, FallbackValue=''}" MinWidth="120" TextAlignment="Right" />
                        <TextBlock Classes="muted small" Text="{Binding StateText}" TextAlignment="Right" />
                      </StackPanel>
                      <Button Grid.Column="4" Classes="iconbtn" ToolTip.Tip="Its container: logs, terminal, files" Margin="8,0,0,0" VerticalAlignment="Center"
                              Command="{Binding $parent[UserControl].((clu:ClustersViewModel)DataContext).OpenNodeCommand}" CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource IconOpenExternal}" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter x:Name="Splitter" Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

    <Border x:Name="Panel" Grid.Column="2" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <clu:ClusterDetailView />
    </Border>
  </Grid>
</UserControl>
