<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Dockyard.Dashboard.Controls"
             xmlns:cont="using:Dockyard.Dashboard.Features.Containers"
             xmlns:res="using:Dockyard.Dashboard.Features.Resources"
             xmlns:sh="using:Dockyard.Shared"
             x:Class="Dockyard.Dashboard.Features.Containers.ComposeDetailView"
             x:DataType="cont:ComposeDetailViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="16,14,16,8" Spacing="8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <PathIcon Data="{StaticResource IconCompose}" Width="18" Height="18" Margin="0,0,10,0" />
        <TextBlock Grid.Column="1" Classes="title" Text="{Binding Project.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="iconbtn" Command="{Binding CloseCommand}" ToolTip.Tip="Close">
          <PathIcon Data="{StaticResource IconClose}" />
        </Button>
      </Grid>
      <TextBlock Classes="muted small" Text="{Binding Project.Location}" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding Project.Location}" />
      <Border Classes="pill" Classes.ok="{Binding Project.IsRunning}">
        <TextBlock Text="{Binding Project.Summary}" />
      </Border>

      <WrapPanel ItemSpacing="6" LineSpacing="6" Margin="0,4,0,0">
        <Button Classes="primary" Command="{Binding UpCommand}" ToolTip.Tip="docker compose up -d">
          <StackPanel Classes="label"><PathIcon Data="{StaticResource IconPlay}" /><TextBlock Text="Up" /></StackPanel>
        </Button>
        <Button Command="{Binding StopCommand}">
          <StackPanel Classes="label"><PathIcon Data="{StaticResource IconStop}" /><TextBlock Text="Stop" /></StackPanel>
        </Button>
        <Button Command="{Binding RestartCommand}">
          <StackPanel Classes="label"><PathIcon Data="{StaticResource IconRestart}" /><TextBlock Text="Restart" /></StackPanel>
        </Button>
        <Button Command="{Binding PullCommand}">
          <StackPanel Classes="label"><PathIcon Data="{StaticResource IconPull}" /><TextBlock Text="Pull" /></StackPanel>
        </Button>
        <Button Classes="danger" Command="{Binding DownCommand}" ToolTip.Tip="Remove containers and networks; volumes are kept">
          <StackPanel Classes="label"><PathIcon Data="{StaticResource IconDown}" /><TextBlock Text="Down…" /></StackPanel>
        </Button>
        <Button Classes="link" Content="Forget" Command="{Binding ForgetCommand}" IsVisible="{Binding IsRecentOnly}"
                ToolTip.Tip="Remove from the recent compose files" />
      </WrapPanel>
      <TextBlock Classes="muted small" Text="{Binding Busy}" IsVisible="{Binding IsBusy}" />

    </StackPanel>

    <TabControl SelectedIndex="{Binding SelectedTab}" Margin="4,0,4,0">
      <TabItem Header="Services">
      <ScrollViewer>
      <StackPanel Margin="12,8,12,8">
      <ItemsControl ItemsSource="{Binding Project.Services}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="res:ComposeService">
            <Grid ColumnDefinitions="*,Auto" Margin="0,3">
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Classes="muted small" Text="{Binding State}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Classes="iconbtn" ToolTip.Tip="Start" CommandParameter="{Binding}"
                        Command="{Binding $parent[UserControl].((cont:ComposeDetailViewModel)DataContext).ServiceStartCommand}">
                  <PathIcon Data="{StaticResource IconPlay}" />
                </Button>
                <Button Classes="iconbtn" ToolTip.Tip="Stop" CommandParameter="{Binding}"
                        Command="{Binding $parent[UserControl].((cont:ComposeDetailViewModel)DataContext).ServiceStopCommand}">
                  <PathIcon Data="{StaticResource IconStop}" />
                </Button>
                <Button Classes="iconbtn" ToolTip.Tip="Restart" CommandParameter="{Binding}"
                        Command="{Binding $parent[UserControl].((cont:ComposeDetailViewModel)DataContext).ServiceRestartCommand}">
                  <PathIcon Data="{StaticResource IconRestart}" />
                </Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
      </ScrollViewer>
      </TabItem>

      <TabItem Header="Compose file">
        <DockPanel Margin="12,8,12,8">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <ComboBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" IsVisible="{Binding HasManyFiles}"
                      IsEnabled="{Binding CanPickFile}" HorizontalAlignment="Stretch" MaxWidth="520"
                      ToolTip.Tip="This project combines several compose files; save before switching" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsFileLoaded}">
              <Button Content="Revert" Command="{Binding RevertCommand}" />
              <Button Content="Save" Command="{Binding SaveCommand}" />
              <Button Classes="primary" Command="{Binding SaveAndApplyCommand}" ToolTip.Tip="Save, then docker compose up -d: only changed services are recreated">
                <StackPanel Classes="label"><PathIcon Data="{StaticResource IconPlay}" /><TextBlock Text="Save and apply" /></StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <SelectableTextBlock DockPanel.Dock="Bottom" Classes="small" TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="120"
                     Text="{Binding FileStatus}" IsVisible="{Binding HasFileStatus}"
                     Classes.muted="{Binding FileOk}" Classes.err="{Binding !FileOk}" />
          <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasNoFiles}"
                     Text="Docker did not record which compose files this project was started from." />
          <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasFileMissing}" Text="{Binding FileMissing}" />
          <sh:CodeEditor Language="Yaml" Text="{Binding FileText}" ProblemLines="{Binding ProblemLines}" IsVisible="{Binding IsFileLoaded}" />
        </DockPanel>
      </TabItem>

      <TabItem Header="Logs">
        <Panel>
          <ListBox Classes="log" ItemsSource="{Binding Logs.Rows}" Background="{DynamicResource Bg}"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="cont:LogRow">
                <ctl:AnsiTextBlock Classes="mono" Classes.err="{Binding IsError}" Line="{Binding Line}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Classes="iconbtn" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,18,0" Command="{Binding OpenLogsCommand}"
                  ToolTip.Tip="Open each container's logs in the log panel, side by side" AutomationProperties.Name="Open in the log panel">
            <PathIcon Data="{StaticResource IconExpand}" />
          </Button>
        </Panel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
