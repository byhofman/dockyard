<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Dockyard.Dashboard.Features.Resources"
             xmlns:files="using:Dockyard.Dashboard.Features.Files"
             x:Class="Dockyard.Dashboard.Features.Resources.VolumesView"
             x:DataType="res:VolumesViewModel">
  <Grid x:Name="Layout" ColumnDefinitions="*,5,380">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="16,12,16,4">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <CheckBox Classes="pick" IsChecked="{Binding AllSelected}" ToolTip.Tip="Select all" AutomationProperties.Name="Select all volumes" />
          <TextBlock Grid.Column="1" Classes="section" Text="VOLUMES" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding PruneCommand}" ToolTip.Tip="Remove the volumes no container uses">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconPrune}" /><TextBlock Text="Prune unused…" /></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <Border Classes="selectionbar" IsVisible="{Binding HasMany}">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="count" Text="{Binding SelectionText}" />
            <Button Grid.Column="1" Classes="danger" Command="{Binding RemoveCommand}" ToolTip.Tip="Volumes in use by a container stay">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Remove…" /></StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="link" Content="Clear" Command="{Binding ClearSelectionCommand}" Margin="12,0,0,0" />
          </Grid>
        </Border>
        <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
          <ProgressBar IsIndeterminate="True" />
          <TextBlock Classes="muted small" Text="{Binding Busy}" />
        </StackPanel>
      </StackPanel>
      <ListBox x:Name="List" Classes="rows" ItemsSource="{Binding Rows}" SelectionMode="Multiple" SelectedItems="{Binding SelectedItems}" Padding="0,4">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="res:VolumeRow">
            <Grid ColumnDefinitions="Auto,*,200,90,Auto">
              <CheckBox Classes="pick" IsChecked="{Binding $parent[ListBoxItem].IsSelected}" AutomationProperties.Name="{Binding DisplayName}" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="muted small" Text="{Binding Driver}" />
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding UsageText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Classes="mono" Text="{Binding SizeText}" TextAlignment="Right" VerticalAlignment="Center" />
              <StackPanel Grid.Column="4" Classes="rowactions" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Classes="iconbtn danger" ToolTip.Tip="Remove (Del)" IsEnabled="{Binding CanRemove}"
                        Command="{Binding $parent[UserControl].((res:VolumesViewModel)DataContext).RemoveRowCommand}" CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource IconDelete}" />
                </Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter x:Name="Splitter" Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

    <Border x:Name="Panel" Grid.Column="2" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <Panel>
      <DockPanel IsVisible="{Binding HasFiles}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="16,14,16,0">
          <TextBlock Classes="title" Text="{Binding Selected.DisplayName, FallbackValue=''}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <Button Grid.Column="1" IsVisible="{Binding CanOpenLocation}" Command="{Binding OpenLocationCommand}" Content="{Binding OpenLocationText}"
                  Margin="8,0,6,0" ToolTip.Tip="The folder you are looking at, where it is, in your file manager" />
          <Button Grid.Column="2" Classes="iconbtn" Command="{Binding CloseFilesCommand}" ToolTip.Tip="Close the files">
            <PathIcon Data="{StaticResource IconClose}" />
          </Button>
        </Grid>
        <files:FilesView DataContext="{Binding Files}" />
      </DockPanel>
      <ScrollViewer IsVisible="{Binding !HasFiles}">
        <StackPanel Margin="16,14" Spacing="10" DataContext="{Binding Selected}" x:DataType="res:VolumeRow">
          <Grid ColumnDefinitions="*,Auto">
            <SelectableTextBlock Classes="title" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="iconbtn" Command="{Binding $parent[UserControl].((res:VolumesViewModel)DataContext).ClearSelectionCommand}" ToolTip.Tip="Close">
              <PathIcon Data="{StaticResource IconClose}" />
            </Button>
          </Grid>
          <WrapPanel ItemSpacing="6" LineSpacing="6" Margin="0,4,0,0">
            <Button Command="{Binding $parent[UserControl].((res:VolumesViewModel)DataContext).OpenFilesCommand}"
                    ToolTip.Tip="Look through what is in this volume" Content="Files" />
            <Button IsVisible="{Binding $parent[UserControl].((res:VolumesViewModel)DataContext).CanOpenLocation}"
                    Command="{Binding $parent[UserControl].((res:VolumesViewModel)DataContext).OpenLocationCommand}"
                    ToolTip.Tip="This volume's folder where it is, in your file manager"
                    Content="{Binding $parent[UserControl].((res:VolumesViewModel)DataContext).OpenLocationText}" />
            <Button Click="ExportClicked" Content="Export a copy…"
                    ToolTip.Tip="Copy this volume's files into a new folder on this computer and show it" />
            <Button Classes="danger" Command="{Binding $parent[UserControl].((res:VolumesViewModel)DataContext).RemoveCommand}"
                    ToolTip.Tip="Volumes in use by a container cannot be removed">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Remove…" /></StackPanel>
            </Button>
          </WrapPanel>
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="{Binding $parent[UserControl].((res:VolumesViewModel)DataContext).Location.Note, FallbackValue=''}" />
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" Margin="0,6,0,0">
            <TextBlock Classes="muted small" Text="Driver" />
            <TextBlock Grid.Column="1" Text="{Binding Driver}" />
            <TextBlock Grid.Row="1" Classes="muted small" Text="Size" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeText}" />
            <TextBlock Grid.Row="2" Classes="muted small" Text="Mountpoint" />
            <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding Mountpoint}" TextWrapping="Wrap" />
          </Grid>
          <TextBlock Classes="section" Text="USED BY" Margin="0,6,0,0" />
          <TextBlock Text="{Binding UsageText}" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
      </Panel>
    </Border>
  </Grid>
</UserControl>
