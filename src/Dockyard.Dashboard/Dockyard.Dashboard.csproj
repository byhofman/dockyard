<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <ApplicationManifest Condition="$(RuntimeIdentifier.StartsWith('win'))">app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Dockyard\Assets\dockyard.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PublishAot>true</PublishAot>
    <Version>0.0.0</Version>
    <Product>Dockyard</Product>
    <AssemblyTitle>Dockyard Dashboard</AssemblyTitle>
    <Company>Thomas Hofman</Company>
    <Copyright>Copyright (c) 2026 Thomas Hofman</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dockyard.Dashboard.Tests" />
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <AvaloniaResource Include="..\Dockyard\Assets\dockyard.ico" Link="Assets\dockyard.ico" />
    <AvaloniaResource Include="..\Dockyard\Assets\dockyard.png" Link="Assets\dockyard.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dockyard.Engine\Dockyard.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
  </ItemGroup>

  <!-- What Task Manager, Activity Monitor and ps show. Only the published file: resources are found by assembly name, and
       a space in that would have to survive every avares:// address. -->
  <Target Name="NameTheProcess" AfterTargets="CopyNativeBinary">
    <PropertyGroup>
      <NativeExtension Condition="$(RuntimeIdentifier.StartsWith('win'))">.exe</NativeExtension>
    </PropertyGroup>
    <Move SourceFiles="$(PublishDir)$(AssemblyName)$(NativeExtension)" DestinationFiles="$(PublishDir)Dockyard Dashboard$(NativeExtension)" />
  </Target>

</Project>
