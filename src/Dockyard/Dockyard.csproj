<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <ApplicationManifest Condition="$(RuntimeIdentifier.StartsWith('win'))">app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\dockyard.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.0.0</Version>
    <Product>Dockyard</Product>
    <Company>Thomas Hofman</Company>
    <Copyright>Copyright (c) 2026 Thomas Hofman</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Trimming strips the runtime's own precompiled code, so without this every launch JITs Avalonia and CoreLib. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The rest of Shared is compiled into Dockyard.Setup, whose internals this project sees. -->
    <Compile Include="..\Shared\CodeEditor.cs;..\Shared\CodeColorizer.cs;..\Shared\DisplayGate.cs" LinkBase="Shared" />
    <InternalsVisibleTo Include="Dockyard.Tests" />
    <!-- The tray's icon, until the Toolbox goes. -->
    <Compile Include="..\Dockyard.Tray\TrayColors.cs;..\Dockyard.Tray\TrayIconRenderer.cs" LinkBase="Tray" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dockyard.Setup\Dockyard.Setup.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
  </ItemGroup>

  <!-- The published Toolbox is dockyard-toolbox, next to dockyard-dashboard and dockyard-cli. Only the published file:
       resources are found by assembly name. -->
  <Target Name="NameTheToolbox" AfterTargets="Publish">
    <PropertyGroup>
      <ExeExtension Condition="$(RuntimeIdentifier.StartsWith('win'))">.exe</ExeExtension>
    </PropertyGroup>
    <Move SourceFiles="$(PublishDir)$(AssemblyName)$(ExeExtension)" DestinationFiles="$(PublishDir)dockyard-toolbox$(ExeExtension)" />
  </Target>

</Project>
