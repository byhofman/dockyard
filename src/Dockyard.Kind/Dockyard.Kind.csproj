<Project Sdk="Microsoft.NET.Sdk">

  <!-- kind clusters as the dashboard and the dockyard command both handle them: kind itself, the kubeconfig, definitions,
       add-ons and shared storage. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dockyard" />
    <InternalsVisibleTo Include="Dockyard.Dashboard" />
    <InternalsVisibleTo Include="Dockyard.Tests" />
    <InternalsVisibleTo Include="Dockyard.Dashboard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

</Project>
