<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:clu="using:Dockyard.Dashboard.Features.Clusters"
             xmlns:ctl="using:Dockyard.Dashboard.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cont="using:Dockyard.Dashboard.Features.Containers"
             xmlns:store="using:Dockyard.Dashboard.Store"
             xmlns:shell="using:Dockyard.Dashboard.Shell"
             x:Class="Dockyard.Dashboard.Features.Containers.ContainersView"
             x:DataType="cont:ContainersViewModel">

  <UserControl.DataTemplates>
    <DataTemplate DataType="cont:ContainerDetailViewModel">
      <cont:ContainerDetailView />
    </DataTemplate>
    <DataTemplate DataType="clu:ClusterDetail">
      <clu:ClusterDetailView />
    </DataTemplate>
    <DataTemplate DataType="cont:ComposeDetailViewModel">
      <cont:ComposeDetailView />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid x:Name="Root" ColumnDefinitions="*,5,440">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="16,12,16,4" IsVisible="{Binding Session.IsConnected}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <CheckBox Classes="pick" IsChecked="{Binding AllSelected}" ToolTip.Tip="Select all" AutomationProperties.Name="Select all containers" />
          <TextBlock Grid.Column="1" Classes="section" Text="CONTAINERS" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <ctl:FilterSwitch IsChecked="{Binding ShowSystem}" Icon="{StaticResource IconLock}" Text="Dockyard"
                              ToolTip.Tip="Show Dockyard's own containers, such as kind's cloud provider and the NFS server" />
            <Button Command="{Binding $parent[Window].((shell:ShellViewModel)DataContext).Clusters.CreateCommand}"
                    ToolTip.Tip="Create a kind cluster">
              <StackPanel Classes="label">
                <PathIcon Data="{StaticResource IconKubernetes}" />
                <TextBlock Text="New cluster" />
              </StackPanel>
            </Button>
            <Button Click="OpenComposeFile" IsEnabled="{Binding Tools.HasCompose}" ToolTip.Tip="Start a compose project from a compose file (docker compose up -d)">
              <StackPanel Classes="label">
                <PathIcon Data="{StaticResource IconOpenFile}" />
                <TextBlock Text="Open compose file…" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <SelectableTextBlock Classes="small" Foreground="{DynamicResource Warn}" TextWrapping="Wrap"
                             Text="{Binding $parent[Window].((shell:ShellViewModel)DataContext).Clusters.ServicesError, FallbackValue={x:Null}}"
                             IsVisible="{Binding $parent[Window].((shell:ShellViewModel)DataContext).Clusters.HasServicesError, FallbackValue=False}" />
        <Border Classes="selectionbar" IsVisible="{Binding HasMany}">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="count" Text="{Binding SelectionText}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Command="{Binding StartPickedCommand}">
                <StackPanel Classes="label"><PathIcon Data="{StaticResource IconPlay}" /><TextBlock Text="Start" /></StackPanel>
              </Button>
              <Button Command="{Binding StopPickedCommand}">
                <StackPanel Classes="label"><PathIcon Data="{StaticResource IconStop}" /><TextBlock Text="Stop" /></StackPanel>
              </Button>
              <Button Command="{Binding RestartPickedCommand}">
                <StackPanel Classes="label"><PathIcon Data="{StaticResource IconRestart}" /><TextBlock Text="Restart" /></StackPanel>
              </Button>
              <Button Classes="danger" Command="{Binding RemovePickedCommand}">
                <StackPanel Classes="label"><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Remove…" /></StackPanel>
              </Button>
            </StackPanel>
            <Button Grid.Column="2" Classes="link" Content="Clear" Command="{Binding ClearSelectionCommand}" Margin="12,0,0,0" />
          </Grid>
        </Border>
        <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
          <ProgressBar IsIndeterminate="True" />
          <TextBlock Classes="muted small" Text="{Binding Busy}" />
        </StackPanel>
      </StackPanel>

      <Panel>
        <ListBox x:Name="List" Classes="rows" Padding="0,6" ItemsSource="{Binding Store.Rows}" SelectionMode="Multiple" SelectedItems="{Binding SelectedItems}"
                 IsVisible="{Binding Session.IsConnected}">
          <ListBox.DataTemplates>
            <DataTemplate DataType="store:ProjectRow">
              <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                <CheckBox Classes="pick" IsChecked="{Binding $parent[ListBoxItem].IsSelected}" AutomationProperties.Name="{Binding Name}" />
                <ctl:ExpandToggle Grid.Column="1" IsExpanded="{Binding IsExpanded}" Command="{Binding $parent[UserControl].((cont:ContainersViewModel)DataContext).ToggleProjectCommand}" CommandParameter="{Binding}" />
                <PathIcon Grid.Column="2" Data="{StaticResource IconCompose}" Width="16" Height="16" Margin="0,0,10,0"
                          Foreground="{DynamicResource Muted}" Classes.running="{Binding IsRunning}" />
                <ctl:RowLabel Grid.Column="3" Title="{Binding Name}" Detail="{Binding Location}" />
                <TextBlock Grid.Column="4" Classes="muted small" Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0" />
                <StackPanel Grid.Column="5" Classes="rowactions" Orientation="Horizontal" VerticalAlignment="Center">
                  <ctl:StartStopButton IsRunning="{Binding IsRunning}" ToolTip.Tip="Start or stop the project"
                          Command="{Binding $parent[UserControl].((cont:ContainersViewModel)DataContext).ProjectStartStopCommand}" CommandParameter="{Binding}" />
                  <Button Classes="iconbtn" ToolTip.Tip="Restart"
                          Command="{Binding $parent[UserControl].((cont:ContainersViewModel)DataContext).ProjectRestartCommand}" CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource IconRestart}" />
                  </Button>
                  <Button Classes="iconbtn danger" ToolTip.Tip="Down: remove its containers and networks"
                          Command="{Binding $parent[UserControl].((cont:ContainersViewModel)DataContext).ProjectDownCommand}" CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource IconDelete}" />
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
            <DataTemplate DataType="store:ClusterRow">
              <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                <CheckBox Classes="pick" IsChecked="{Binding $parent[ListBoxItem].IsSelected}" AutomationProperties.Name="{Binding Name}" />
                <ctl:ExpandToggle Grid.Column="1" IsExpanded="{Binding IsExpanded}" Command="{Binding $parent[UserControl].((cont:ContainersViewModel)DataContext).ToggleClusterCommand}" CommandParameter="{Binding}" />
                <PathIcon Grid.Column="2" Data="{StaticResource IconKubernetes}" Width="16" Height="16" Margin="0,0,10,0"
                          Foreground="{DynamicResource Muted}" Classes.running="{Binding IsRunning}" />
                <ctl:RowLabel Grid.Column="3" Title="{Binding Name}" Detail="{Binding Location}" />
                <TextBlock Grid.Column="4" Classes="muted small" Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0" />
                <StackPanel Grid.Column="5" Classes="rowactions" Orientation="Horizontal" VerticalAlignment="Center">
                  <ctl:StartStopButton IsRunning="{Binding IsRunning}" ToolTip.Tip="Start or stop the cluster; everything in it stays"
                          Command="{Binding $parent[UserControl].((cont:ContainersViewModel)DataContext).ClusterStartStopCommand}" CommandParameter="{Binding}" />
                  <Button Classes="iconbtn" ToolTip.Tip="Open in Kubernetes"
                          Command="{Binding $parent[UserControl].((cont:ContainersViewModel)DataContext).OpenClusterCommand}" CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource IconOpenExternal}" />
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>

            <DataTemplate DataType="store:SystemRow">
              <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Opacity="0.6" ToolTip.Tip="{Binding Location}">
                <Border Width="28" />
                <ctl:ExpandToggle Grid.Column="1" IsExpanded="{Binding IsExpanded}" Command="{Binding $parent[UserControl].((cont:ContainersViewModel)DataContext).ToggleSystemCommand}" CommandParameter="{Binding}" />
                <PathIcon Grid.Column="2" Data="{StaticResource IconLock}" Width="16" Height="16" Margin="0,0,10,0" Foreground="{DynamicResource Muted}" />
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Classes="muted small" Text="{Binding Location}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="4" Classes="muted small" Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0" />
              </Grid>
            </DataTemplate>
            <DataTemplate DataType="store:ContainerItem">
              <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" Classes.system="{Binding IsSystem}">
                <CheckBox Grid.Column="1" Classes="pick" Classes.unpickable="{Binding IsSystem}" IsChecked="{Binding $parent[ListBoxItem].IsSelected}" AutomationProperties.Name="{Binding Name}" />
                <Border Width="24" IsVisible="{Binding IsGrouped}" />
                <ctl:StatusDot Grid.Column="2" IsOn="{Binding IsRunning}" />
                <ctl:RowLabel Grid.Column="3" Margin="12,0" Title="{Binding Name}" Detail="{Binding Image}" />
                <ctl:PortLinks Grid.Column="4" ItemsSource="{Binding Ports}" OpenCommand="{Binding $parent[UserControl].((cont:ContainersViewModel)DataContext).OpenPortCommand}" />
                <TextBlock Grid.Column="5" Classes="muted mono" Text="{Binding UsageText}" MinWidth="120" TextAlignment="Right"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="6" Classes="rowactions" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                  <Button Classes="iconbtn" ToolTip.Tip="Restart" IsVisible="{Binding IsSystem}"
                          Command="{Binding $parent[UserControl].((cont:ContainersViewModel)DataContext).RestartCommand}" CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource IconRestart}" />
                  </Button>
                  <ctl:StartStopButton IsRunning="{Binding IsRunning}" ToolTip.Tip="Start or stop (S)"
                          Command="{Binding $parent[UserControl].((cont:ContainersViewModel)DataContext).ToggleCommand}" CommandParameter="{Binding}" />
                  <Button Classes="iconbtn" ToolTip.Tip="Terminal (E)" IsEnabled="{Binding IsRunning}" IsVisible="{Binding IsManaged}"
                          Command="{Binding $parent[UserControl].((cont:ContainersViewModel)DataContext).ExecCommand}" CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource IconTerminal}" />
                  </Button>
                  <Button Classes="iconbtn danger" ToolTip.Tip="Remove (Del)" IsVisible="{Binding IsManaged}"
                          Command="{Binding $parent[UserControl].((cont:ContainersViewModel)DataContext).AskRemoveCommand}" CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource IconDelete}" />
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>

        <ctl:EmptyState IsVisible="{Binding IsEmpty}" Icon="IconContainers" Text="No containers yet. Run one with docker run, or open a compose file." />

        <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                    IsVisible="{Binding Session.IsUnavailable}">
          <PathIcon Data="{StaticResource IconContainers}" Width="40" Height="40" Foreground="{DynamicResource Muted}" />
          <TextBlock Classes="title" HorizontalAlignment="Center" Text="The Docker engine is not running" />
          <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding Session.Error}" />
          <Button Classes="primary" HorizontalAlignment="Center"
                  IsVisible="{Binding $parent[Window].((shell:ShellViewModel)DataContext).CanStartEngine}"
                  Command="{Binding $parent[Window].((shell:ShellViewModel)DataContext).StartEngineCommand}">
            <StackPanel Classes="label">
              <PathIcon Data="{StaticResource IconPlay}" />
              <TextBlock Text="Start engine" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Panel>
    </DockPanel>

    <GridSplitter x:Name="Splitter" Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

    <Border x:Name="DetailHost" Grid.Column="2" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <ContentControl Content="{Binding Detail}" />
    </Border>
  </Grid>
</UserControl>
