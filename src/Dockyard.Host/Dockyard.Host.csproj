<Project Sdk="Microsoft.NET.Sdk">

  <!-- dockyard-host: what of Dockyard has to run on Windows itself, without a window and listening only where Windows
       cannot reach the engine otherwise. The Toolbox installs it and starts nothing of this itself. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>dockyard-host</AssemblyName>
    <RootNamespace>Dockyard.Host</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Product>Dockyard</Product>
    <Company>Thomas Hofman</Company>
    <Copyright>Copyright (c) 2026 Thomas Hofman</Copyright>
    <Version>0.0.0</Version>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dockyard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\WslPaths.cs" LinkBase="Shared" />
    <Compile Include="..\Shared\HostPipe.cs" LinkBase="Shared" />
    <Compile Include="..\Shared\LocalPipe.cs" LinkBase="Shared" />
    <Compile Include="..\Shared\TrayCommand.cs" LinkBase="Shared" />
    <Compile Include="..\Shared\TrayCommandKind.cs" LinkBase="Shared" />
    <Compile Include="..\Dockyard\Core\WslEngineRelay.cs" LinkBase="Relays" />
    <Compile Include="..\Dockyard\Core\AcceptLoop.cs" LinkBase="Relays" />
    <Compile Include="..\Dockyard\Core\WslEngineGate.cs" LinkBase="Relays" />
    <Compile Include="..\Dockyard\Core\TcpRelay.cs" LinkBase="Relays" />
    <Compile Include="..\Dockyard\Core\DomainRelay.cs" LinkBase="Relays" />
    <Compile Include="..\Dockyard\Core\LoopbackForwarder.cs" LinkBase="Relays" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dockyard.Engine\Dockyard.Engine.csproj" />
  </ItemGroup>

</Project>
