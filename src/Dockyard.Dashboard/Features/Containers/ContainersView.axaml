<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cont="using:Dockyard.Dashboard.Features.Containers"
             xmlns:store="using:Dockyard.Dashboard.Store"
             xmlns:shell="using:Dockyard.Dashboard.Shell"
             x:Class="Dockyard.Dashboard.Features.Containers.ContainersView"
             x:DataType="cont:ContainersViewModel">

  <UserControl.DataTemplates>
    <DataTemplate DataType="cont:ContainerDetailViewModel">
      <cont:ContainerDetailView />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid x:Name="Root" ColumnDefinitions="*,440">
    <Panel>
      <ListBox x:Name="List" Classes="rows" Padding="0,8" ItemsSource="{Binding Store.Rows}" SelectedItem="{Binding SelectedRow}"
               IsVisible="{Binding Session.IsConnected}">
        <ListBox.DataTemplates>
          <DataTemplate DataType="store:GroupHeader">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="section" Text="{Binding Title}" />
              <TextBlock Classes="muted small" Text="{Binding Summary}" />
            </StackPanel>
          </DataTemplate>
          <DataTemplate DataType="store:ContainerItem">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <Ellipse Classes="dot" Classes.on="{Binding IsRunning}" />
              <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="muted small" Text="{Binding Image}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <ItemsControl Grid.Column="2" ItemsSource="{Binding Ports}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="store:PublishedPort">
                    <Button Classes="link" Content="{Binding HostPort}" ToolTip.Tip="{Binding Url}"
                            Command="{Binding $parent[UserControl].((cont:ContainersViewModel)DataContext).OpenPortCommand}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Grid.Column="3" Classes="muted mono" Text="{Binding UsageText}" MinWidth="120" TextAlignment="Right"
                         VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>

      <TextBlock Classes="muted" Text="No containers yet. Run one with docker run or start a compose project."
                 IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" />

      <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                  IsVisible="{Binding Session.IsUnavailable}">
        <TextBlock Classes="title" HorizontalAlignment="Center" Text="The Docker engine is not running" />
        <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding Session.Error}" />
        <Button Classes="primary" HorizontalAlignment="Center" Content="Start engine"
                IsVisible="{Binding $parent[Window].((shell:ShellViewModel)DataContext).CanStartEngine}"
                Command="{Binding $parent[Window].((shell:ShellViewModel)DataContext).StartEngineCommand}" />
      </StackPanel>
    </Panel>

    <Border x:Name="DetailHost" Grid.Column="1" IsVisible="{Binding HasDetail}" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <ContentControl Content="{Binding Detail}" />
    </Border>
  </Grid>
</UserControl>
