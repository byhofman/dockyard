<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:eng="using:Dockyard.Dashboard.Features.Engine"
             xmlns:ctl="using:Dockyard.Dashboard.Controls"
             x:Class="Dockyard.Dashboard.Features.Engine.EngineSettingsView"
             x:DataType="eng:EngineSettingsViewModel">
  <Grid Margin="24,18" RowDefinitions="Auto,Auto,*,Auto,Auto" MaxWidth="980" HorizontalAlignment="Stretch">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Classes="title">
          <Run Text="{Binding EngineTitle}" /><Run Text=" · daemon.json" />
        </TextBlock>
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Explanation}" />
      </StackPanel>
      <Button Grid.Column="1" Command="{Binding ReloadCommand}" Margin="24,0,0,0" VerticalAlignment="Top" ToolTip.Tip="Read it again">
        <PathIcon Data="{StaticResource IconRefresh}" />
      </Button>
    </Grid>
    <TextBlock Grid.Row="1" Classes="muted small" Margin="0,8,0,0" IsVisible="{Binding !HasCli}"
               Text="The dockyard command is not next to the dashboard, so the settings cannot be read or applied from here." />
    <ctl:CodeEditor Grid.Row="2" Margin="0,12,0,0" MinHeight="240" Language="Json" Text="{Binding Text}" />
    <StackPanel Grid.Row="3" Spacing="6" Margin="0,10,0,0">
      <TextBlock Foreground="{DynamicResource Bad}" TextWrapping="Wrap" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" />
      <TextBlock Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Text="{Binding Notes}" IsVisible="{Binding HasNotes}" />
      <Border Classes="note" Padding="10,8" CornerRadius="6" IsVisible="{Binding HasCheckResult}"
              Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <SelectableTextBlock TextWrapping="Wrap" Text="{Binding CheckResult}" />
      </Border>
      <TextBlock Classes="muted small" Text="{Binding Busy}" IsVisible="{Binding IsBusy}" />
    </StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Revert" Command="{Binding RevertCommand}" />
      <Button Content="Check" Command="{Binding CheckCommand}" ToolTip.Tip="Ask dockerd whether it starts with these settings" />
      <Button Classes="primary" Content="Apply…" Command="{Binding ApplyCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
