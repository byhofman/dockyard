<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>dockyard-agent</AssemblyName>
    <RootNamespace>Dockyard.Agent</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>none</DebugType>
    <StaticExecutable Condition="$(RuntimeIdentifier.StartsWith('linux-musl'))">true</StaticExecutable>
    <StaticOpenSslLinking Condition="$(RuntimeIdentifier.StartsWith('linux-musl'))">true</StaticOpenSslLinking>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dockyard.Agent.Tests" />
    <ProjectReference Include="..\Dockyard.Engine\Dockyard.Engine.csproj" />
    <!-- A static executable cannot dlopen, so what it calls in libc has to be linked in: without this vsock and the clock
         fail at their first call, on the one engine that needs them. -->
    <DirectPInvoke Include="libc" />
  </ItemGroup>

</Project>
