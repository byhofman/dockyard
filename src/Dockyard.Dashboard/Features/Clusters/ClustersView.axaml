<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:clu="using:Dockyard.Dashboard.Features.Clusters"
             xmlns:res="using:Dockyard.Dashboard.Features.Resources"
             x:Class="Dockyard.Dashboard.Features.Clusters.ClustersView"
             x:DataType="clu:ClustersViewModel">
  <Grid x:Name="Layout" ColumnDefinitions="*,5,380">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="16,12,16,4">
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasKind}">
          <TextBox PlaceholderText="New cluster name, such as dev" Text="{Binding NewName}" />
          <Button Grid.Column="1" Classes="primary" Command="{Binding CreateCommand}" Margin="8,0,0,0">
            <StackPanel Classes="label"><PathIcon Data="{StaticResource IconPlus}" /><TextBlock Text="Create cluster" /></StackPanel>
          </Button>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasHint}">
          <TextBlock Classes="muted" Text="{Binding Hint}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Classes="link" Content="Engines and settings" Command="{Binding OpenSettingsCommand}" IsVisible="{Binding !HasKind}" />
        </StackPanel>
        <TextBlock Classes="muted small" Text="{Binding Busy}" IsVisible="{Binding IsBusy}" />
        <res:ConfirmBar DataContext="{Binding Confirm}" IsVisible="{Binding $parent[UserControl].((clu:ClustersViewModel)DataContext).HasConfirm}" />
      </StackPanel>
      <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasOutput}" MaxHeight="180" Margin="16,4,16,12"
              Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Output}" Margin="10,6">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <SelectableTextBlock Classes="mono small" Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <ListBox Classes="rows" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Padding="0,4">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="clu:KindCluster">
            <Grid ColumnDefinitions="*,120,110">
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="muted small mono" Text="{Binding Context}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding KubernetesVersion}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Classes="small" Text="{Binding StateText}" TextAlignment="Right" />
                <TextBlock Classes="muted small" Text="{Binding NodesText}" TextAlignment="Right" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter x:Name="Splitter" Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

    <Border x:Name="Panel" Grid.Column="2" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel Margin="18,14" Spacing="10">
          <TextBlock Classes="title" Text="{Binding Selected.Name}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding Selected.Summary}" TextWrapping="Wrap" />

          <TextBlock Classes="section" Text="KUBECONFIG" Margin="0,8,0,0" />
          <TextBlock Classes="muted small" Text="Context" />
          <SelectableTextBlock Classes="mono" Text="{Binding Selected.Context}" />
          <TextBlock Classes="muted small" Text="API server" />
          <SelectableTextBlock Classes="mono" Text="{Binding Selected.ApiServer, FallbackValue=''}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding CopyKubeconfigCommand}" ToolTip.Tip="kind get kubeconfig, onto the clipboard">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconCopy}" /><TextBlock Text="Copy kubeconfig" /></StackPanel>
            </Button>
            <Button Command="{Binding UseContextCommand}" ToolTip.Tip="kind export kubeconfig: adds it to ~/.kube/config and makes it the current context">
              <TextBlock Text="Use context" />
            </Button>
          </StackPanel>
          <SelectableTextBlock Classes="mono muted small" Text="{Binding KubectlHint}" TextWrapping="Wrap" />

          <TextBlock Classes="section" Text="NODES" Margin="0,8,0,0" />
          <ItemsControl ItemsSource="{Binding Selected.Nodes, FallbackValue={x:Null}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="clu:KindNode">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted small" Text="{Binding Role}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding State}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Classes="danger" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding DeleteCommand}">
            <StackPanel Classes="label"><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Delete cluster" /></StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
