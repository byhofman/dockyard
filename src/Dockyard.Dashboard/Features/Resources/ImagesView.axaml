<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Dockyard.Dashboard.Features.Resources"
             x:Class="Dockyard.Dashboard.Features.Resources.ImagesView"
             x:DataType="res:ImagesViewModel">
  <Grid x:Name="Layout" ColumnDefinitions="*,5,380">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="16,12,16,4">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBox PlaceholderText="Image to pull, e.g. nginx:alpine" Text="{Binding PullReference}" />
          <Button Grid.Column="1" Classes="primary" Command="{Binding PullCommand}" Margin="8,0" IsDefault="True">
            <StackPanel Classes="label"><PathIcon Data="{StaticResource IconPull}" /><TextBlock Text="Pull" /></StackPanel>
          </Button>
          <Button Grid.Column="2" Command="{Binding PruneCommand}" ToolTip.Tip="Remove untagged images that no container uses">
            <StackPanel Classes="label"><PathIcon Data="{StaticResource IconPrune}" /><TextBlock Text="Prune dangling" /></StackPanel>
          </Button>
        </Grid>
        <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
          <ProgressBar Value="{Binding PullPercent}" Maximum="100" />
          <TextBlock Classes="muted small" Text="{Binding Busy}" />
          <TextBlock Classes="muted small" Text="{Binding PullStatus}" />
        </StackPanel>
        <res:ConfirmBar DataContext="{Binding Confirm}" IsVisible="{Binding $parent[UserControl].((res:ImagesViewModel)DataContext).HasConfirm}" />
      </StackPanel>
      <ListBox Classes="rows" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Padding="0,4">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="res:ImageRow">
            <Grid ColumnDefinitions="*,110,100,90">
              <StackPanel>
                <TextBlock Text="{Binding Reference}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="muted mono" Text="{Binding ShortId}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding UsageText}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding CreatedText}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Classes="mono" Text="{Binding SizeText}" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter x:Name="Splitter" Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

    <Border x:Name="Panel" Grid.Column="2" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel Margin="18,14" Spacing="10" DataContext="{Binding Selected}" x:DataType="res:ImageRow">
          <TextBlock Classes="title" Text="{Binding Reference}" TextWrapping="Wrap" />
          <SelectableTextBlock Classes="mono muted" Text="{Binding Id}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Classes="muted small" Text="Size" />
            <TextBlock Grid.Column="1" Text="{Binding SizeText}" />
            <TextBlock Grid.Row="1" Classes="muted small" Text="Created" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CreatedText}" />
            <TextBlock Grid.Row="2" Classes="muted small" Text="Used by" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UsageText}" />
          </Grid>
          <TextBlock Classes="section" Text="TAGS" Margin="0,6,0,0" />
          <ItemsControl ItemsSource="{Binding Tags}" />
          <TextBlock Classes="section" Text="CONTAINERS" Margin="0,6,0,0" IsVisible="{Binding InUse}" />
          <ItemsControl ItemsSource="{Binding UsedBy}" />
          <Button Classes="danger" HorizontalAlignment="Left" Margin="0,8,0,0"
                  Command="{Binding $parent[UserControl].((res:ImagesViewModel)DataContext).RemoveCommand}">
            <StackPanel Classes="label"><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Remove" /></StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
