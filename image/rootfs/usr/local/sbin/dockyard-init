#!/bin/sh
# Starts the Docker engine in the foreground: the WSL session (or VM agent) that runs this keeps the engine alive.
set -eu

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
tcp="${DOCKYARD_TCP:-}"

if ! grep -q ' /sys/fs/cgroup cgroup2 ' /proc/mounts; then
  mkdir -p /sys/fs/cgroup
  mount -t cgroup2 cgroup2 /sys/fs/cgroup
fi

mkdir -p /var/run /var/lib/docker
rm -f /var/run/docker.sock /var/run/docker.pid

if [ "$tcp" = none ]; then
  exec dockerd -H unix:///var/run/docker.sock
fi

# WSL: nothing else starts the agent. It leaves when dockerd does, so that it does not keep the distro alive by itself,
# and a crash brings it back because that exits non-zero.
(until dockyard-agent --mode=wsl; do sleep 1; done) >/dev/null 2>&1 &
# dockerd has no TCP listener of its own: whatever reaches a port here, every Windows user and web page can reach too.
# The agent serves the engine to Windows only with the tray's token. DOCKYARD_TCP asks for a plain port, for tests.
if [ -z "$tcp" ]; then
  exec dockerd -H unix:///var/run/docker.sock
fi
exec dockerd -H unix:///var/run/docker.sock -H "tcp://$tcp" --tls=false
