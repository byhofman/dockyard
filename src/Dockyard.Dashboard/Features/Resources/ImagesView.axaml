<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Dockyard.Dashboard.Features.Resources"
             xmlns:files="using:Dockyard.Dashboard.Features.Files"
             x:Class="Dockyard.Dashboard.Features.Resources.ImagesView"
             x:DataType="res:ImagesViewModel">
  <Grid x:Name="Layout" ColumnDefinitions="*,5,380">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="16,12,16,4">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <CheckBox Classes="pick" IsChecked="{Binding AllSelected}" ToolTip.Tip="Select all" AutomationProperties.Name="Select all images" />
          <TextBlock Grid.Column="1" Classes="section" Text="IMAGES" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Command="{Binding PullCommand}">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconPull}" /><TextBlock Text="Pull image…" /></StackPanel>
            </Button>
            <Button Command="{Binding PruneCommand}" ToolTip.Tip="Remove untagged images that no container uses">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconPrune}" /><TextBlock Text="Prune dangling…" /></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="3" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="segment" Classes.selected="{Binding Usage.IsAll}" Content="{Binding Usage.AllText}" Command="{Binding Usage.ShowCommand}" CommandParameter="All" />
            <Button Classes="segment" Classes.selected="{Binding Usage.IsUsed}" Content="{Binding Usage.UsedText}" Command="{Binding Usage.ShowCommand}" CommandParameter="Used"
                    ToolTip.Tip="Used by a container, running or not" />
            <Button Classes="segment" Classes.selected="{Binding Usage.IsUnused}" Content="{Binding Usage.UnusedText}" Command="{Binding Usage.ShowCommand}" CommandParameter="Unused"
                    ToolTip.Tip="No container uses it" />
          </StackPanel>
        </Border>
        <Border Classes="selectionbar" IsVisible="{Binding HasMany}">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="count" Text="{Binding SelectionText}" />
            <Button Grid.Column="1" Classes="danger" Command="{Binding RemoveCommand}">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Remove…" /></StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="link" Content="Clear" Command="{Binding ClearSelectionCommand}" Margin="12,0,0,0" />
          </Grid>
        </Border>
        <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
          <ProgressBar IsIndeterminate="True" />
          <TextBlock Classes="muted small" Text="{Binding Busy}" />
        </StackPanel>
      </StackPanel>
      <ListBox x:Name="List" Classes="rows" ItemsSource="{Binding Rows}" SelectionMode="Multiple" SelectedItems="{Binding SelectedItems}" Padding="0,4">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="res:ImageRow">
            <Grid ColumnDefinitions="Auto,*,110,100,90,Auto">
              <CheckBox Classes="pick" IsChecked="{Binding $parent[ListBoxItem].IsSelected}" AutomationProperties.Name="{Binding Reference}" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Reference}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="muted mono" Text="{Binding ShortId}" />
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding UsageText}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Classes="muted small" Text="{Binding CreatedText}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" Classes="mono" Text="{Binding SizeText}" TextAlignment="Right" VerticalAlignment="Center" />
              <StackPanel Grid.Column="5" Classes="rowactions" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Classes="iconbtn" ToolTip.Tip="Terminal in a new container of this image"
                        Command="{Binding $parent[UserControl].((res:ImagesViewModel)DataContext).TerminalRowCommand}" CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource IconTerminal}" />
                </Button>
                <Button Classes="iconbtn danger" ToolTip.Tip="Remove (Del)"
                        Command="{Binding $parent[UserControl].((res:ImagesViewModel)DataContext).RemoveRowCommand}" CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource IconDelete}" />
                </Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter x:Name="Splitter" Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

    <Border x:Name="Panel" Grid.Column="2" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <Panel>
      <DockPanel IsVisible="{Binding HasFiles}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,14,16,0">
          <TextBlock Classes="title" Text="{Binding Selected.Reference, FallbackValue=''}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="iconbtn" Command="{Binding CloseFilesCommand}" ToolTip.Tip="Close the files">
            <PathIcon Data="{StaticResource IconClose}" />
          </Button>
        </Grid>
        <files:FilesView DataContext="{Binding Files}" />
      </DockPanel>
      <ScrollViewer IsVisible="{Binding !HasFiles}">
        <StackPanel Margin="16,14" Spacing="10" DataContext="{Binding Selected}" x:DataType="res:ImageRow">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="title" Text="{Binding Reference}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="iconbtn" Command="{Binding $parent[UserControl].((res:ImagesViewModel)DataContext).ClearSelectionCommand}" ToolTip.Tip="Close">
              <PathIcon Data="{StaticResource IconClose}" />
            </Button>
          </Grid>
          <SelectableTextBlock Classes="mono muted" Text="{Binding Id}" TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="6" LineSpacing="6" Margin="0,4,0,0">
            <Button Command="{Binding $parent[UserControl].((res:ImagesViewModel)DataContext).OpenFilesCommand}"
                    ToolTip.Tip="Look through the files in this image" Content="Files" />
            <Button Command="{Binding $parent[UserControl].((res:ImagesViewModel)DataContext).TerminalCommand}"
                    ToolTip.Tip="A shell in a new container of this image, removed when the terminal closes">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconTerminal}" /><TextBlock Text="Terminal" /></StackPanel>
            </Button>
            <Button Classes="danger" Command="{Binding $parent[UserControl].((res:ImagesViewModel)DataContext).RemoveCommand}" ToolTip.Tip="Remove (Del)">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Remove…" /></StackPanel>
            </Button>
          </WrapPanel>
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" Margin="0,6,0,0">
            <TextBlock Classes="muted small" Text="Size" />
            <TextBlock Grid.Column="1" Text="{Binding SizeText}" />
            <TextBlock Grid.Row="1" Classes="muted small" Text="Created" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CreatedText}" />
            <TextBlock Grid.Row="2" Classes="muted small" Text="Used by" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UsageText}" />
          </Grid>
          <TextBlock Classes="section" Text="TAGS" Margin="0,6,0,0" />
          <ItemsControl ItemsSource="{Binding Tags}" />
          <TextBlock Classes="section" Text="CONTAINERS" Margin="0,6,0,0" IsVisible="{Binding InUse}" />
          <ItemsControl ItemsSource="{Binding UsedBy}" />
        </StackPanel>
      </ScrollViewer>
      </Panel>
    </Border>
  </Grid>
</UserControl>
