<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dockyard.ViewModels"
        xmlns:sh="using:Dockyard.Shared"
        x:Class="Dockyard.Views.EngineSettingsWindow"
        x:DataType="vm:EngineSettingsViewModel"
        Title="{Binding Title}"
        Width="860" Height="640" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}">
  <Grid Margin="20,16" RowDefinitions="Auto,*,Auto,Auto">
    <StackPanel Spacing="4">
      <TextBlock Classes="h2" Text="{Binding Title}" />
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Explanation}" />
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                 Text="Ctrl+Space lists the common settings with what they do; Add puts a whole one in." />
    </StackPanel>

    <sh:CodeEditor Grid.Row="1" Margin="0,12,0,0" Language="Json" Text="{Binding Text}"
                   ProblemLines="{Binding IssueLines}" Completions="{Binding Completions}" />

    <StackPanel Grid.Row="2" Spacing="4" Margin="0,10,0,0">
      <ItemsControl ItemsSource="{Binding IssueTexts}" IsVisible="{Binding HasIssues}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Warn}" Text="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <SelectableTextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding Verdict}" IsVisible="{Binding HasVerdict}"
                           Classes.ok="{Binding VerdictOk}" Classes.bad="{Binding !VerdictOk}" />
      <TextBlock Classes="muted" FontSize="12" Text="{Binding Busy}" IsVisible="{Binding IsBusy}" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
      <Button Content="Add ▾">
        <Button.Flyout>
          <MenuFlyout ItemsSource="{Binding Snippets}">
            <MenuFlyout.ItemContainerTheme>
              <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:EngineSettingsViewModel+SnippetItem">
                <Setter Property="Header" Value="{Binding Title}" />
                <Setter Property="Command" Value="{Binding Command}" />
              </ControlTheme>
            </MenuFlyout.ItemContainerTheme>
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button Content="Revert" Command="{Binding RevertCommand}" />
        <Button Classes="primary" Content="Apply" Command="{Binding ApplyCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
