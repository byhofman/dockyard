<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <ApplicationManifest Condition="$(RuntimeIdentifier.StartsWith('win'))">app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\dockyard.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.0.0</Version>
    <Product>Dockyard</Product>
    <Company>Thomas Hofman</Company>
    <Copyright>Copyright (c) 2026 Thomas Hofman</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Trimming strips the runtime's own precompiled code, so without this every launch JITs Avalonia and CoreLib. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Hosts\setup-linux.sh" LogicalName="setup-linux.sh" />
    <EmbeddedResource Include="..\..\image\versions.env" LogicalName="versions.env" />
    <EmbeddedResource Include="..\..\image\versions.sha256" LogicalName="versions.sha256" />
    <EmbeddedResource Condition="'$(GuestBundle)' != ''" Include="$(GuestBundle)" LogicalName="guest.tar.gz" />
    <EmbeddedResource Condition="'$(HostExe)' != ''" Include="$(HostExe)" LogicalName="dockyard-host.exe" />
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <InternalsVisibleTo Include="Dockyard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dockyard.Engine\Dockyard.Engine.csproj" />
    <ProjectReference Include="..\Dockyard.Kind\Dockyard.Kind.csproj" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

  <!-- The published Toolbox is dockyard-toolbox, next to dockyard-dashboard and dockyard-cli. Only the published file:
       resources are found by assembly name. -->
  <Target Name="NameTheToolbox" AfterTargets="Publish">
    <PropertyGroup>
      <ExeExtension Condition="$(RuntimeIdentifier.StartsWith('win'))">.exe</ExeExtension>
    </PropertyGroup>
    <Move SourceFiles="$(PublishDir)$(AssemblyName)$(ExeExtension)" DestinationFiles="$(PublishDir)dockyard-toolbox$(ExeExtension)" />
  </Target>

</Project>
