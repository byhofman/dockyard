<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Dockyard.Dashboard.Shell"
        xmlns:cont="using:Dockyard.Dashboard.Features.Containers"
        xmlns:res="using:Dockyard.Dashboard.Features.Resources"
        xmlns:clu="using:Dockyard.Dashboard.Features.Clusters"
        xmlns:eng="using:Dockyard.Dashboard.Features.Engine"
        xmlns:ctl="using:Dockyard.Dashboard.Controls"
        x:Class="Dockyard.Dashboard.Shell.MainWindow"
        x:DataType="shell:ShellViewModel"
        Title="Dockyard Dashboard"
        Icon="avares://Dockyard.Dashboard/Assets/dockyard.ico"
        Width="1240" Height="760" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <Window.DataTemplates>
    <DataTemplate DataType="cont:ContainersViewModel">
      <cont:ContainersView />
    </DataTemplate>
    <DataTemplate DataType="res:ImagesViewModel">
      <res:ImagesView />
    </DataTemplate>
    <DataTemplate DataType="res:VolumesViewModel">
      <res:VolumesView />
    </DataTemplate>
    <DataTemplate DataType="res:NetworksViewModel">
      <res:NetworksView />
    </DataTemplate>
    <DataTemplate DataType="res:DiskViewModel">
      <res:DiskView />
    </DataTemplate>
    <DataTemplate DataType="eng:EngineSettingsViewModel">
      <eng:EngineSettingsView />
    </DataTemplate>
    <DataTemplate DataType="clu:ClustersViewModel">
      <clu:ClustersView />
    </DataTemplate>
  </Window.DataTemplates>

  <Window.Styles>
    <Style Selector="Border.searchmenu">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BoxShadow" Value="0 10 28 0 #40000000" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ListBox.search">
      <Setter Property="Padding" Value="0,6" />
    </Style>
    <Style Selector="ListBox.search ListBoxItem" x:DataType="shell:SearchHit">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="6,1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
    </Style>
    <Style Selector="ListBox.search ListBoxItem:disabled">
      <Setter Property="Padding" Value="8,10,8,2" />
    </Style>
    <Style Selector="ListBox.search ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
    </Style>
    <Style Selector="ListBox.search ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Selected}" />
    </Style>
    <Style Selector="ListBox.search ListBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.searchicon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.searchicon PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="ListBox.search ListBoxItem:selected Border.searchicon">
      <Setter Property="Background" Value="{DynamicResource AccentBg}" />
    </Style>
    <Style Selector="ListBox.search ListBoxItem:selected Border.searchicon PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector="Border.toast">
      <Setter Property="Background" Value="{DynamicResource OkBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Ok}" />
    </Style>
    <Style Selector="Border.toast.error">
      <Setter Property="Background" Value="{DynamicResource BadBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Bad}" />
    </Style>
  </Window.Styles>

  <Panel>
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Image Source="avares://Dockyard.Dashboard/Assets/dockyard.png" Width="26" Height="26" />
            <TextBlock Classes="h1" Text="Dockyard" VerticalAlignment="Center" />
          </StackPanel>

          <TextBox x:Name="SearchBox" Grid.Column="1" Margin="40,0,16,0" MaxWidth="380" HorizontalAlignment="Stretch"
                   PlaceholderText="{Binding SearchHint}" Text="{Binding Search}" VerticalAlignment="Center" >
            <TextBox.InnerLeftContent>
              <PathIcon Data="{StaticResource IconSearch}" Margin="10,0,0,0" Foreground="{DynamicResource Muted}" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <Popup Grid.Column="1" PlacementTarget="{Binding #SearchBox}" Placement="BottomEdgeAlignedLeft" VerticalOffset="6"
                 IsOpen="{Binding IsSearchOpen, Mode=TwoWay}" IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding #SearchBox}">
            <Border Classes="searchmenu" Width="{Binding #SearchBox.Bounds.Width}" MinWidth="380">
              <DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,8" IsVisible="{Binding !HasNoHits}">
                  <TextBlock Classes="muted small" Text="↑ ↓  to move     Enter  to open     Esc  to close" />
                </Border>
                <StackPanel>
                  <StackPanel Margin="16,18" Spacing="4" IsVisible="{Binding HasNoHits}">
                    <TextBlock FontWeight="SemiBold" Text="Nothing matches" />
                    <TextBlock Classes="muted small" Text="Containers, Compose projects, images, volumes, networks and clusters are searched by name." TextWrapping="Wrap" />
                  </StackPanel>
                  <ListBox x:Name="SearchResults" Classes="search" ItemsSource="{Binding Hits}" SelectedIndex="{Binding HitIndex, Mode=TwoWay}" MaxHeight="440"
                           Tapped="OpenSearchResult" Focusable="False">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="shell:SearchHit">
                        <Panel>
                          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsHeader}" Margin="4,0">
                            <TextBlock Classes="section" Text="{Binding HeaderText}" />
                            <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding TotalText}" VerticalAlignment="Center" />
                          </Grid>
                          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsSelectable}">
                            <Border Classes="searchicon">
                              <PathIcon Data="{Binding Icon}" Width="14" Height="14" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="muted small" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                          </Grid>
                        </Panel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </DockPanel>
            </Border>
          </Popup>

          <Border Grid.Column="2" Classes="pill warn" Margin="0,0,12,0" IsVisible="{Binding Session.IsReconnecting}">
            <TextBlock Text="Reconnecting…" />
          </Border>

          <Border Grid.Column="3" IsVisible="{Binding HasEngineSwitch}" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}"
                  BorderThickness="1" CornerRadius="7" Padding="3" VerticalAlignment="Center" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="segment" Classes.selected="{Binding IsLinuxActive}" Content="Linux" Command="{Binding SwitchLinuxCommand}"
                      ToolTip.Tip="Switch to Linux containers" />
              <Button Classes="segment" Classes.selected="{Binding IsWindowsActive}" Content="Windows" Command="{Binding SwitchWindowsCommand}"
                      ToolTip.Tip="Switch to Windows containers" />
            </StackPanel>
          </Border>

          <Button Grid.Column="4" Classes="iconbtn" Command="{Binding SettingsCommand}" ToolTip.Tip="Engines, updates and settings">
            <PathIcon Data="{StaticResource IconSettings}" Width="18" Height="18" />
          </Button>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,4">
        <Grid ColumnDefinitions="Auto,*">
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding Activity.IsWorking}" Width="60" MinWidth="60" Margin="0,0,10,0" VerticalAlignment="Center" />
          <Button x:Name="ActivityButton" Grid.Column="1" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left"
                  Command="{Binding Activity.ToggleCommand}" ToolTip.Tip="Show or hide what the dashboard did" AutomationProperties.Name="Activity">
            <TextBlock Classes="muted small" Text="{Binding Activity.Current}" TextTrimming="CharacterEllipsis" />
          </Button>
          <Popup Grid.Column="1" PlacementTarget="{Binding #ActivityButton}" Placement="TopEdgeAlignedLeft" VerticalOffset="-6"
                 IsOpen="{Binding Activity.IsOpen, Mode=TwoWay}" IsLightDismissEnabled="True">
            <Border Classes="searchmenu" Width="620" MaxHeight="340" Padding="12,10">
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Activity.Lines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <SelectableTextBlock Classes="mono small" Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </Popup>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="170,*">
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
          <ListBox Classes="sidebar" Margin="0,10" ItemsSource="{Binding Sections}" SelectedItem="{Binding CurrentSection}">
            <!-- Otherwise an item is named after the record's ToString, so screen readers and UI Automation never find "Clusters". -->
            <ListBox.Styles>
              <Style Selector="ListBoxItem" x:DataType="shell:Section">
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="shell:Section">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Data="{Binding Icon}" Width="16" Height="16" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
        <ContentControl Grid.Column="1" Content="{Binding CurrentSection.Content}" />
      </Grid>
    </DockPanel>

    <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" MaxWidth="420">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="8" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="shell:Toast">
          <Border Classes="toast" Classes.error="{Binding IsError}" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
              <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
              <Button Grid.Column="1" Classes="iconbtn" VerticalAlignment="Top" Margin="8,-4,-6,0" Click="DismissToast">
                <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Panel x:Name="DialogLayer" IsVisible="{Binding HasDialog}">
      <Border Background="{DynamicResource Scrim}" Opacity="0.55" />
      <Border Classes="dialog" DataContext="{Binding Dialog}" x:DataType="shell:Dialog"
              HorizontalAlignment="Center" VerticalAlignment="Center" Width="{Binding Width}" Margin="16"
              Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="20,18">
        <StackPanel Spacing="12">
          <TextBlock Classes="title" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding HasMessage}" />
          <ItemsControl ItemsSource="{Binding Fields}" IsEnabled="{Binding IsIdle}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="shell:DialogField">
                <StackPanel Spacing="4">
                  <TextBlock Classes="muted small" Text="{Binding Label}" IsVisible="{Binding HasLabel}" />
                  <TextBox Classes="dialogfield" Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" IsVisible="{Binding IsText}"
                           AutomationProperties.Name="{Binding Label}" />
                  <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" IsVisible="{Binding IsChoice}"
                            AutomationProperties.Name="{Binding Label}" />
                  <CheckBox IsChecked="{Binding IsChecked}" IsVisible="{Binding IsCheck}" AutomationProperties.Name="{Binding Label}">
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                  </CheckBox>
                  <ctl:CodeEditor Height="260" Language="{Binding Language}" Text="{Binding Text}" IsVisible="{Binding IsCode}" AutomationProperties.Name="{Binding Label}" />
                  <TextBlock Foreground="{DynamicResource Bad}" FontSize="12" TextWrapping="Wrap" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <CheckBox Content="{Binding OptionText}" IsChecked="{Binding Option}" IsVisible="{Binding HasOption}" IsEnabled="{Binding IsIdle}" />
          <StackPanel Spacing="6" IsVisible="{Binding HasProgress}">
            <ProgressBar IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding Percent}" Maximum="100" />
            <TextBlock Classes="muted small" Text="{Binding Progress}" TextWrapping="Wrap" />
          </StackPanel>
          <Border Background="{DynamicResource BadBg}" CornerRadius="6" Padding="10,8" IsVisible="{Binding HasError}">
            <ScrollViewer MaxHeight="160">
              <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button Content="Hide" Command="{Binding HideCommand}" IsVisible="{Binding IsWorking}"
                    ToolTip.Tip="Close this; it goes on, and says how it ended" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsIdle}" IsCancel="True" />
            <Button Classes="primary" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True" IsVisible="{Binding IsPrimary}" />
            <Button Classes="dangerfill" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsVisible="{Binding IsDanger}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>
  </Panel>
</Window>
