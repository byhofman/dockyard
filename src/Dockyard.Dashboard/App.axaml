<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Dockyard.Dashboard.App"
             Name="Dockyard"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Bg" Color="#0E1117" />
          <SolidColorBrush x:Key="Surface" Color="#161B23" />
          <SolidColorBrush x:Key="SurfaceRaised" Color="#1D2330" />
          <SolidColorBrush x:Key="Selected" Color="#1B2A4A" />
          <SolidColorBrush x:Key="Line" Color="#262D3B" />
          <SolidColorBrush x:Key="Text" Color="#E7EBF3" />
          <SolidColorBrush x:Key="Muted" Color="#8A94A6" />
          <SolidColorBrush x:Key="Ok" Color="#2FBF71" />
          <SolidColorBrush x:Key="OkBg" Color="#1A3A2A" />
          <SolidColorBrush x:Key="Warn" Color="#F0A92E" />
          <SolidColorBrush x:Key="WarnBg" Color="#3D2F14" />
          <SolidColorBrush x:Key="Bad" Color="#EF5350" />
          <SolidColorBrush x:Key="BadBg" Color="#3D1C1C" />
          <SolidColorBrush x:Key="PillBg" Color="#262D3B" />
          <SolidColorBrush x:Key="LinkText" Color="#6F9CFF" />
          <SolidColorBrush x:Key="TextControlBackground" Color="#0B0E14" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0F131B" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0B0E14" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2A3243" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3A4559" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#3B7BF5" />
          <SolidColorBrush x:Key="TextControlForeground" Color="#E7EBF3" />
          <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E7EBF3" />
          <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E7EBF3" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6B7588" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#6B7588" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#6B7588" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#0B0E14" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#0F131B" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#0F131B" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2A3243" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#3A4559" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#3B7BF5" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#161B23" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#252C3B" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2C3446" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#323B4E" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#323B4E" />
          <SolidColorBrush x:Key="ToggleButtonBackground" Color="#1D2330" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#262D3B" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#252C3B" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Bg" Color="#F5F6F8" />
          <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceRaised" Color="#EEF0F4" />
          <SolidColorBrush x:Key="Selected" Color="#DCE7FD" />
          <SolidColorBrush x:Key="Line" Color="#DFE3EA" />
          <SolidColorBrush x:Key="Text" Color="#1A1F29" />
          <SolidColorBrush x:Key="Muted" Color="#5F6B7D" />
          <SolidColorBrush x:Key="Ok" Color="#178A4E" />
          <SolidColorBrush x:Key="OkBg" Color="#DDF3E6" />
          <SolidColorBrush x:Key="Warn" Color="#A86D00" />
          <SolidColorBrush x:Key="WarnBg" Color="#FCEFD6" />
          <SolidColorBrush x:Key="Bad" Color="#C9302C" />
          <SolidColorBrush x:Key="BadBg" Color="#FBE1E0" />
          <SolidColorBrush x:Key="PillBg" Color="#E8EBF0" />
          <SolidColorBrush x:Key="LinkText" Color="#1D63ED" />
          <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FAFBFC" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D3D8E0" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#B9C0CC" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#1D63ED" />
          <SolidColorBrush x:Key="TextControlForeground" Color="#1A1F29" />
          <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#1A1F29" />
          <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#1A1F29" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8A94A6" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8A94A6" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8A94A6" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FAFBFC" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#F2F4F7" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#D3D8E0" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#B9C0CC" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#1D63ED" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E4E7EC" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#DADEE5" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#CDD3DC" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#CDD3DC" />
          <SolidColorBrush x:Key="ToggleButtonBackground" Color="#EEF0F4" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#DFE3EA" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#E4E7EC" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Color x:Key="SystemAccentColor">#1D63ED</Color>
      <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
      <SolidColorBrush x:Key="Accent" Color="#1D63ED" />
      <SolidColorBrush x:Key="AccentHover" Color="#3B7BF5" />
      <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>

      <!-- Material Design Icons (Apache-2.0), 24x24 -->
      <StreamGeometry x:Key="IconContainers">M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L6.04,7.5L12,10.85L17.96,7.5L12,4.15M5,15.91L11,19.29V12.58L5,9.21V15.91M19,15.91V9.21L13,12.58V19.29L19,15.91Z</StreamGeometry>
