<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dockyard.ViewModels"
        x:Class="Dockyard.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Dockyard"
        Icon="avares://Dockyard/Assets/docker.ico"
        Width="860" Height="700" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <Flyout x:Key="ConfirmUninstall" Placement="TopEdgeAlignedRight">
      <StackPanel Spacing="12" MaxWidth="320" x:DataType="vm:MainViewModel">
        <TextBlock FontWeight="SemiBold" Text="Uninstall Dockyard?" />
        <TextBlock TextWrapping="Wrap" Classes="muted"
                   Text="Removes Dockyard, its engines, the docker CLI and the contexts." />
        <CheckBox IsChecked="{Binding RemoveData}" Content="Also delete my images and containers" />
        <Button Classes="dangerfill" Content="Uninstall" Command="{Binding UninstallCommand}" HorizontalAlignment="Right" />
      </StackPanel>
    </Flyout>
  </Window.Resources>

  <DockPanel>

    <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Image Source="avares://Dockyard/Assets/whale-blue.png" Width="34" Height="34" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Classes="h1" Text="Dockyard" />
            <TextBlock Classes="muted" FontSize="12" Text="Docker engines on demand, without Docker Desktop" />
          </StackPanel>
        </StackPanel>

        <Border Grid.Column="2" IsVisible="{Binding HasEngineSwitch}" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="3" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <ItemsControl ItemsSource="{Binding EngineCards}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:EngineViewModel">
                  <Button Classes="segment" Classes.selected="{Binding IsActive}" Content="{Binding Name}" Command="{Binding UseCommand}" ToolTip.Tip="Switch the docker context to this engine" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="80" MinWidth="80" VerticalAlignment="Center" Margin="0,0,12,0" />
        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Classes="muted mono" Text="{Binding Version}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="20" Spacing="22">

        <!-- Setup -->
        <StackPanel Spacing="10" IsVisible="{Binding ShowInstall}">
          <TextBlock Classes="h2" Text="SETUP" />
          <Border Classes="card">
            <StackPanel Spacing="14">
              <TextBlock TextWrapping="Wrap" Text="{Binding SetupDescription}" />
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                <CheckBox IsChecked="{Binding IncludeDashboard}" Content="Include the dashboard" VerticalAlignment="Center"
                          ToolTip.Tip="A window for your containers, images, volumes, networks and disk use. You can add or remove it later here or in the tray window." />
                <Button Grid.Column="1" Classes="primary" Content="Install" Command="{Binding InstallCommand}" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- The wizard on an existing install -->
        <StackPanel Spacing="10" IsVisible="{Binding ShowWizardManage}">
          <TextBlock Classes="h2" Text="MANAGE" />
          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" Text="{Binding ManageText}" />
              <Button Grid.Column="1" Classes="primary" Content="Update" Command="{Binding InstallCommand}" />
            </Grid>
          </Border>
        </StackPanel>

        <!-- A reboot the install asked for -->
        <Border Classes="card" IsVisible="{Binding NeedsReboot}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" Text="Windows has to restart to finish. Dockyard carries on by itself afterwards." />
            <Button Grid.Column="1" Classes="primary" Content="Restart now" Command="{Binding RebootCommand}" />
          </Grid>
        </Border>

        <!-- Engines -->
        <StackPanel Spacing="10" IsVisible="{Binding IsDashboard}">
          <TextBlock Classes="h2" Text="ENGINES" />
          <ItemsControl ItemsSource="{Binding EngineCards}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EngineViewModel">
                <Border Classes="card" Classes.active="{Binding IsActive}" Margin="0,0,10,0">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="title" Text="{Binding Title}" />
                    <Border Grid.Column="1" Classes="pill accent" IsVisible="{Binding IsActive}">
                      <TextBlock Text="ACTIVE CONTEXT" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="muted" Text="{Binding Subtitle}" Margin="0,2,0,12" />
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                      <Ellipse Classes="dot" Classes.on="{Binding IsRunning}" />
                      <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                    </StackPanel>
                    <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                      <TextBlock Classes="muted mono" Text="{Binding Endpoint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="link" Content="Use" Command="{Binding UseCommand}" IsVisible="{Binding IsInactive}" />
                        <Button Classes.primary="{Binding IsStopped}" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" MinWidth="72" HorizontalContentAlignment="Center" />
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Updates -->
        <StackPanel Spacing="10" IsVisible="{Binding ShowManage}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="COMPONENTS" VerticalAlignment="Bottom" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="Check for updates" Command="{Binding CheckUpdatesCommand}" />
              <Button Classes="primary" Content="Update all" Command="{Binding UpdateAllCommand}" />
            </StackPanel>
          </Grid>
          <Border Classes="card" Padding="0">
            <StackPanel>
              <Grid ColumnDefinitions="*,110,110,140,96" Margin="18,12">
                <TextBlock Classes="muted" FontSize="12" Text="Component" />
                <TextBlock Grid.Column="1" Classes="muted" FontSize="12" Text="Installed" />
                <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Text="Latest" />
                <TextBlock Grid.Column="3" Classes="muted" FontSize="12" Text="Status" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Components}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ComponentViewModel">
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,10">
                      <Grid ColumnDefinitions="*,110,110,140,96">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Installed}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="mono" Text="{Binding Latest}" VerticalAlignment="Center" />
                        <Border Grid.Column="3" Classes="pill" Classes.ok="{Binding IsUpToDate}" Classes.warn="{Binding IsAvailable}" Classes.bad="{Binding IsProblem}" ToolTip.Tip="{Binding Error}">
                          <TextBlock Text="{Binding StatusText}" />
                        </Border>
                        <Button Grid.Column="4" Classes="primary" Content="Update" Command="{Binding UpdateCommand}" IsVisible="{Binding IsAvailable}" HorizontalAlignment="Right" />
                        <Button Grid.Column="4" Classes="primary" Content="Add" Command="{Binding AddCommand}" IsVisible="{Binding CanAdd}" HorizontalAlignment="Right" />
                        <Button Grid.Column="4" Classes="danger" Content="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" HorizontalAlignment="Right" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Settings -->
        <StackPanel Spacing="10" IsVisible="{Binding ShowManage}">
          <TextBlock Classes="h2" Text="SETTINGS" />
          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <ToggleSwitch IsChecked="{Binding StopOtherOnSwitch}" IsVisible="{Binding HasEngineSwitch}"
                            OnContent="Stop the other engine when switching" OffContent="Stop the other engine when switching" />
              <ToggleSwitch Grid.Row="1" IsChecked="{Binding StartActiveAtLogon}" OnContent="Start the active engine at logon" OffContent="Start the active engine at logon" />
              <Button Grid.Column="1" Grid.RowSpan="2" Classes="danger" Content="Uninstall…" VerticalAlignment="Center" Flyout="{StaticResource ConfirmUninstall}" />
            </Grid>
          </Border>
        </StackPanel>

        <!-- Engine configuration -->
        <StackPanel Spacing="10" IsVisible="{Binding ShowEngineConfiguration}">
          <TextBlock Classes="h2" Text="LINUX ENGINE" />
          <Border Classes="card">
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto">
              <StackPanel Margin="0,0,10,0" Spacing="4">
                <TextBlock Classes="muted" FontSize="12" Text="Registry mirrors, one per line" />
                <TextBox Classes="mono" AcceptsReturn="True" Height="76" Text="{Binding RegistryMirrors}" PlaceholderText="https://mirror.example.com" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,10,0" Spacing="4">
                <TextBlock Classes="muted" FontSize="12" Text="Insecure registries, one per line" />
                <TextBox Classes="mono" AcceptsReturn="True" Height="76" Text="{Binding InsecureRegistries}" PlaceholderText="registry.example.com:5000" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Classes="muted" FontSize="12" Text="Address pools: range and network size" />
                <TextBox Classes="mono" AcceptsReturn="True" Height="76" Text="{Binding AddressPools}" PlaceholderText="10.20.0.0/16 24" />
              </StackPanel>
              <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Foreground="#C4314B" TextWrapping="Wrap" Margin="0,10,0,0" Text="{Binding EngineConfigurationProblem}" IsVisible="{Binding HasEngineConfigurationProblem}" />
              <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                <TextBlock Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" Text="Applying restarts the engine if it is running, which stops containers that have no restart policy." />
                <Button Grid.Column="1" Classes="primary" Content="Apply" Command="{Binding ApplyEngineConfigurationCommand}" />
              </Grid>
            </Grid>
          </Border>
        </StackPanel>

        <!-- HTTPS -->
        <StackPanel Spacing="10" IsVisible="{Binding ShowManage}">
          <TextBlock Classes="h2" Text="CONTAINER DOMAINS" />
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock TextWrapping="Wrap" Text="Every running container answers at http://name.dockyard.test, without publishing a port." />
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HttpsDisabled}">
                <TextBlock Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                           Text="Trusted HTTPS needs a certificate of Dockyard's own in this computer's trust store. It is made here, stays on this device and is valid only for names under dockyard.test. Your system asks for approval when you turn it on. Plain HTTP works without it." />
                <Button Grid.Column="1" Classes="primary" Content="Turn on HTTPS" Command="{Binding EnableHttpsCommand}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HttpsEnabled}">
                <TextBlock Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                           Text="HTTPS is on, for names under dockyard.test only. Turning it off or uninstalling removes the certificate from the trust store." />
                <Button Grid.Column="1" Content="Turn off HTTPS" Command="{Binding DisableHttpsCommand}" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Import -->
        <StackPanel Spacing="10" IsVisible="{Binding ShowImport}">
          <TextBlock Classes="h2" Text="DOCKER DESKTOP" />
          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" Text="Copy your images, volumes and containers from Docker Desktop. It is started if it is not running, and keeps everything. Containers arrive stopped." />
              <Button Grid.Column="1" Classes="primary" Content="Import" Command="{Binding ImportCommand}" />
            </Grid>
          </Border>
        </StackPanel>

        <!-- Activity -->
        <Expander Header="Activity" IsExpanded="{Binding IsSetupMode, Mode=OneTime}" HorizontalAlignment="Stretch">
          <SelectableTextBlock x:Name="LogBox" Classes="mono" Text="{Binding LogText}" TextWrapping="Wrap" MinHeight="80" />
        </Expander>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
