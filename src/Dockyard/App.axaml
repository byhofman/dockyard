      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Bg" Color="#0F1218" />
          <SolidColorBrush x:Key="Surface" Color="#1C222C" />
          <SolidColorBrush x:Key="SurfaceRaised" Color="#262D3A" />
          <SolidColorBrush x:Key="Hover" Color="#222936" />
          <SolidColorBrush x:Key="Selected" Color="#18375A" />
          <SolidColorBrush x:Key="SelectedText" Color="#8CCAF7" />
          <SolidColorBrush x:Key="Line" Color="#353F51" />
          <SolidColorBrush x:Key="Text" Color="#E7EBF3" />
