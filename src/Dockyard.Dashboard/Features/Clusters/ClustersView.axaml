<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:clu="using:Dockyard.Dashboard.Features.Clusters"
             xmlns:store="using:Dockyard.Dashboard.Store"
             x:Class="Dockyard.Dashboard.Features.Clusters.ClustersView"
             x:DataType="clu:ClustersViewModel">
  <Grid x:Name="Layout" ColumnDefinitions="*,5,380">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="16,12,16,4">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <CheckBox Classes="pick" IsChecked="{Binding AllSelected}" ToolTip.Tip="Select all" AutomationProperties.Name="Select all clusters" />
          <TextBlock Grid.Column="1" Classes="section" Text="CLUSTERS" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
            <ToggleSwitch IsChecked="{Binding LoadBalancersEnabled}" IsVisible="{Binding HasKind}" OnContent="Load balancers" OffContent="Load balancers"
                          VerticalAlignment="Center" ToolTip.Tip="kind's cloud provider: LoadBalancer services get an address on 127.0.0.1" />
            <Button Classes="primary" Command="{Binding CreateCommand}" IsVisible="{Binding HasKind}">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconPlus}" /><TextBlock Text="Create cluster…" /></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasHint}">
          <TextBlock Classes="muted" Text="{Binding Hint}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Classes="link" Content="Engines and settings" Command="{Binding OpenSettingsCommand}" IsVisible="{Binding !HasKind}" />
        </StackPanel>
        <Border Classes="selectionbar" IsVisible="{Binding HasMany}">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="count" Text="{Binding SelectionText}" />
            <Button Grid.Column="1" Classes="danger" Command="{Binding DeleteCommand}">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Delete…" /></StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="link" Content="Clear" Command="{Binding ClearSelectionCommand}" Margin="12,0,0,0" />
          </Grid>
        </Border>
        <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
          <ProgressBar IsIndeterminate="True" />
          <TextBlock Classes="muted small" Text="{Binding Busy}" />
        </StackPanel>
      </StackPanel>
      <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasOutput}" MaxHeight="180" Margin="16,4,16,12"
              Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Output}" Margin="10,6">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <SelectableTextBlock Classes="mono small" Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <ListBox x:Name="List" Classes="rows" ItemsSource="{Binding Rows}" SelectionMode="Multiple" SelectedItems="{Binding SelectedItems}" Padding="0,4">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="clu:KindCluster">
            <Grid ColumnDefinitions="Auto,*,120,110,Auto">
              <CheckBox Classes="pick" IsChecked="{Binding $parent[ListBoxItem].IsSelected}" AutomationProperties.Name="{Binding Name}" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="muted small mono" Text="{Binding Context}" />
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="mono muted" Text="{Binding KubernetesVersion}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="3" VerticalAlignment="Center">
                <TextBlock Classes="small" Text="{Binding StateText}" TextAlignment="Right" />
                <TextBlock Classes="muted small" Text="{Binding NodesText}" TextAlignment="Right" />
              </StackPanel>
              <StackPanel Grid.Column="4" Classes="rowactions" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Classes="iconbtn danger" ToolTip.Tip="Delete (Del)"
                        Command="{Binding $parent[UserControl].((clu:ClustersViewModel)DataContext).DeleteRowCommand}" CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource IconDelete}" />
                </Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter x:Name="Splitter" Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

    <Border x:Name="Panel" Grid.Column="2" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel Margin="16,14" Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="title" Text="{Binding Selected.Name, FallbackValue=''}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="iconbtn" Command="{Binding ClearSelectionCommand}" ToolTip.Tip="Close">
              <PathIcon Data="{StaticResource IconClose}" />
            </Button>
          </Grid>
          <TextBlock Classes="muted" Text="{Binding Selected.Summary, FallbackValue=''}" TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="6" LineSpacing="6" Margin="0,4,0,0">
            <Button Command="{Binding UseContextCommand}" ToolTip.Tip="Makes it the current context in your kubeconfig, adding it back if it went missing">
              <TextBlock Text="Use context" />
            </Button>
            <Button Command="{Binding CopyKubeconfigCommand}" ToolTip.Tip="kind get kubeconfig, onto the clipboard">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconCopy}" /><TextBlock Text="Copy kubeconfig" /></StackPanel>
            </Button>
            <Button Classes="danger" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete (Del)">
              <StackPanel Classes="label"><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Delete…" /></StackPanel>
            </Button>
          </WrapPanel>

          <TextBlock Classes="section" Text="KUBECONFIG" Margin="0,8,0,0" />
          <TextBlock Classes="muted small" Text="Context" />
          <SelectableTextBlock Classes="mono" Text="{Binding Selected.Context, FallbackValue=''}" />
          <TextBlock Classes="muted small" Text="API server" />
          <SelectableTextBlock Classes="mono" Text="{Binding Selected.ApiServer, FallbackValue=''}" />
          <SelectableTextBlock Classes="mono muted small" Text="{Binding KubectlHint}" TextWrapping="Wrap" />

          <TextBlock Classes="section" Text="STORAGE" Margin="0,8,0,0" />
          <TextBlock Classes="muted" Text="{Binding SharedStorageText}" TextWrapping="Wrap" />
          <Button Content="Open the shared folder" Command="{Binding OpenSharedFolderCommand}" IsVisible="{Binding HasSharedFolder}"
                  HorizontalAlignment="Left" ToolTip.Tip="{Binding SharedFolder}" />

          <TextBlock Classes="section" Text="LOAD BALANCERS" Margin="0,8,0,0" />
          <ItemsControl ItemsSource="{Binding LoadBalancerRows}" IsVisible="{Binding HasLoadBalancers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="clu:LoadBalancer">
                <StackPanel Margin="0,2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Service}" TextTrimming="CharacterEllipsis" />
                    <SelectableTextBlock Classes="muted mono" Text="{Binding Address}" IsVisible="{Binding HasAddress}"
                                         ToolTip.Tip="The service's load balancer IP on the kind network, as kubectl shows it under EXTERNAL-IP" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Ports}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="10" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="store:PublishedPort">
                        <Button Classes="link" ToolTip.Tip="{Binding Text}" CommandParameter="{Binding}"
                                Command="{Binding $parent[UserControl].((clu:ClustersViewModel)DataContext).OpenUrlCommand}">
                          <StackPanel Classes="label" Spacing="3">
                            <TextBlock Classes="mono" Text="{Binding Url}" />
                            <PathIcon Data="{StaticResource IconOpenExternal}" Width="10" Height="10" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted small" Text="{Binding LoadBalancerHint}" TextWrapping="Wrap" IsVisible="{Binding !HasLoadBalancers}" />

          <TextBlock Classes="section" Text="NODES" Margin="0,8,0,0" />
          <ItemsControl ItemsSource="{Binding Selected.Nodes, FallbackValue={x:Null}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="clu:KindNode">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted small" Text="{Binding Role}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding State}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
