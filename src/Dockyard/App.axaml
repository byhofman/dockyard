          <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#1A1F29" />
          <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#1A1F29" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#566275" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#566275" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#566275" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FAFBFC" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#F2F4F7" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#CDD3DC" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#B3BBC8" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#1B74C9" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E4E8EE" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#DADFE7" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#C9D0DA" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#C9D0DA" />
          <SolidColorBrush x:Key="ToggleButtonBackground" Color="#EEF1F5" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#DCE1E8" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#E4E8EE" />
          <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#EEF1F5" />
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#EEF1F5" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#DCE1E8" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="#DCE1E8" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="#DCE1E8" />
          <SolidColorBrush x:Key="ExpanderContentBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#DCE1E8" />
