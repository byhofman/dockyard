<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setup="using:Dockyard.Dashboard.Features.Setup"
             xmlns:dctl="using:Dockyard.Dashboard.Controls"
             x:Class="Dockyard.Dashboard.Features.Setup.SettingsView"
             x:DataType="setup:SettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="page">
      <StackPanel Classes="pagehead">
        <TextBlock Classes="title" Text="Settings" />
        <TextBlock Classes="muted small" Text="A change applies at once." TextWrapping="Wrap" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="14" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="setup:SettingGroup">
            <StackPanel Spacing="6">
              <TextBlock Classes="section" Text="{Binding Header}" Margin="2,0" />
              <Border Classes="card">
                <ItemsControl Classes="hairlines" ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="setup:SettingItem">
                      <dctl:SettingRow Classes="cardrow" Title="{Binding Definition.Title}" Description="{Binding Definition.Description}"
                                       IsLinuxEngineOnly="{Binding ShowsLinuxEngineOnly}" NeedsAdmin="{Binding Definition.NeedsAdmin}"
                                       Status="{Binding Status}" Error="{Binding Error}">
                        <dctl:SettingEditor Kind="{Binding Definition.Kind}" Choices="{Binding Definition.Choices}" ChoiceTitles="{Binding Definition.ChoiceTitles}" Value="{Binding Value}"
                                            Label="{Binding Definition.Title}" EditText="{Binding EditText}" EditCommand="{Binding EditCommand}"
                                            IsHitTestVisible="{Binding !IsWorking}" />
                      </dctl:SettingRow>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
