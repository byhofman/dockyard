          <SolidColorBrush x:Key="TextControlForeground" Color="#E7EBF3" />
          <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E7EBF3" />
          <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E7EBF3" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#98A2B3" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#98A2B3" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#98A2B3" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#12161D" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#151A22" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#151A22" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#3A4456" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#4A566C" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#5DB7FF" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#1C222C" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2E3646" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#353F51" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#44506A" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#44506A" />
          <SolidColorBrush x:Key="ToggleButtonBackground" Color="#262D3A" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#353F51" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#2E3646" />
          <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#1C222C" />
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#262D3A" />
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#262D3A" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#353F51" />
